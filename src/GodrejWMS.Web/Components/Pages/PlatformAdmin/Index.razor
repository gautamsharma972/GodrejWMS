@page "/platform-admin"
@attribute [Authorize(Roles = "Platform Admin")]
@using GodrejWMS.Application.Features.OrganizationSettings.Dtos
@using GodrejWMS.Application.Features.OrganizationSettings.Queries
@using GodrejWMS.Application.Features.PlatformAdmin.Queries
@inject IMediator Mediator

<PageTitle>Platform Admin</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <div class="eyebrow">Vendor Console</div>
            <h1>Platform Admin</h1>
            <p class="page-kicker">Organization-wide settings and oversight - not visible to the client.</p>
        </div>
    </div>

    @if (_settings is null)
    {
        <div class="loading-panel">
            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
            Loading...
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-3 mb-4 metric-grid">
            <div class="col">
                <div class="card metric-card h-100">
                    <div class="card-body">
                        <div class="metric-icon"><i class="bi bi-people"></i></div>
                        <h6 class="card-subtitle">Users</h6>
                        <p class="card-text metric-value">@_settings.CurrentUserCount</p>
                        <p class="card-text text-muted">@LimitLabel(_settings.MaxUsers) limit</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card metric-card h-100">
                    <div class="card-body">
                        <div class="metric-icon"><i class="bi bi-building"></i></div>
                        <h6 class="card-subtitle">Warehouses</h6>
                        <p class="card-text metric-value">@_settings.CurrentWarehouseCount</p>
                        <p class="card-text text-muted">@LimitLabel(_settings.MaxWarehouses) limit</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card metric-card h-100">
                    <div class="card-body">
                        <div class="metric-icon"><i class="bi bi-person-badge"></i></div>
                        <h6 class="card-subtitle">Total Accounts</h6>
                        <p class="card-text metric-value">@(_totalAccounts?.ToString() ?? "-")</p>
                        <p class="card-text text-muted">Across every role, including Platform Admin</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <section class="picker-action-section" aria-labelledby="platform-admin-actions-title">
        <div class="picker-section-heading">
            <div>
                <span class="eyebrow">Quick access</span>
                <h2 id="platform-admin-actions-title">Choose a task</h2>
            </div>
        </div>

        <div class="picker-action-grid">
            <a class="picker-action-card" href="/platform-admin/logs">
                <span class="picker-action-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span>
                <span class="picker-action-content">
                    <strong>Server Logs</strong>
                    <small>Browse the rolling log files by date, with level breakdowns and top warnings/errors.</small>
                </span>
                <span class="picker-action-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></span>
            </a>

            <a class="picker-action-card" href="/platform-admin/settings">
                <span class="picker-action-icon"><i class="bi bi-sliders" aria-hidden="true"></i></span>
                <span class="picker-action-content">
                    <strong>Organization Limits</strong>
                    <small>Set the Max Users / Max Warehouses caps. Changes apply immediately.</small>
                </span>
                <span class="picker-action-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></span>
            </a>

            <a class="picker-action-card" href="/platform-admin/accounts">
                <span class="picker-action-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                <span class="picker-action-content">
                    <strong>All Accounts</strong>
                    <small>Every account in the system, and break-glass Platform Admin account creation.</small>
                </span>
                <span class="picker-action-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></span>
            </a>

            <a class="picker-action-card" href="/platform-admin/geofencing">
                <span class="picker-action-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
                <span class="picker-action-content">
                    <strong>Picker Geofencing</strong>
                    <small>Restrict Pickers-role mobile sign-in to within range of their warehouse.</small>
                </span>
                <span class="picker-action-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></span>
            </a>
        </div>
    </section>
</div>

@code {
    private OrganizationSettingsDto? _settings;
    private int? _totalAccounts;

    protected override async Task OnInitializedAsync()
    {
        _settings = await Mediator.Send(new GetOrganizationSettingsQuery());
        var users = await Mediator.Send(new GetAllUsersForPlatformAdminQuery());
        _totalAccounts = users.Count;
    }

    private static string LimitLabel(int? limit) => limit?.ToString() ?? "No";
}
