<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for GodrejWMS.PickersApi (the JWT REST API behind the Pickers mobile app;
  shares the Application/Infrastructure layers and database with GodrejWMS.Web, but runs as its
  own process on its own port).
  Output: <repo>/publish/pickers-api   (emptied before each publish, so no stale files survive a re-publish)
  Use:    dotnet publish src/GodrejWMS.PickersApi -p:PublishProfile=Api     (or scripts/publish.sh api)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\pickers-api\</PublishDir>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <!-- dotnet publish only overwrites files; clear the folder first so removed/renamed files don't linger. -->
  <Target Name="ClearApiPublishDir" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>
</Project>
