<AuthorizeView>
    <Authorized Context="sidebarUserContext">
        <div class="sidebar-user-footer">
            <a class="sidebar-user-profile"
               href="Account/Manage"
               title="Manage account"
               data-bs-toggle="tooltip"
               data-bs-placement="right">
                <span class="sidebar-user-avatar" aria-hidden="true">@UserInitial(sidebarUserContext.User.Identity?.Name)</span>
                <span class="sidebar-user-details">
                    <strong>@(sidebarUserContext.User.Identity?.Name ?? "Signed-in user")</strong>
                    <span>@UserRole(sidebarUserContext.User)</span>
                </span>
            </a>
            <form action="Account/Logout" method="post" class="sidebar-logout-form">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@CurrentRelativeUrl" />
                <button type="submit"
                        class="sidebar-logout"
                        title="Logout"
                        aria-label="Logout"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    <span class="sidebar-logout-text">Logout</span>
                </button>
            </form>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public bool SidebarCollapsed { get; set; }

    private bool? _inwardMenuExpanded;
    private bool? _pulloutMenuExpanded;
    private bool? _inventoryMovementMenuExpanded;
    private string? _collapsedFlyout;
    private double _collapsedFlyoutTop = 88;
    private ElementReference _inwardButton;
    private ElementReference _pulloutButton;
    private ElementReference _movementButton;

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        if (!SidebarCollapsed)
            _collapsedFlyout = null;
    }

    private string CurrentRelativeUrl => NavManager.ToBaseRelativePath(NavManager.Uri);

    private static string UserInitial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "U" : name.Trim()[0].ToString().ToUpperInvariant();

    private static string UserRole(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.Role)?.Value ?? "Warehouse user";

    private bool IsInwardMenuOpen => _inwardMenuExpanded ?? IsInwardSection();

    private bool IsPulloutMenuOpen => _pulloutMenuExpanded ?? IsPulloutSection();

    private bool IsInventoryMovementMenuOpen => _inventoryMovementMenuExpanded ?? IsInventoryMovementSection();

    private Task ToggleInwardMenuAsync() => ToggleMenuAsync("inward", _inwardButton,
        () => _inwardMenuExpanded = !IsInwardMenuOpen);

    private Task TogglePulloutMenuAsync() => ToggleMenuAsync("pullout", _pulloutButton,
        () => _pulloutMenuExpanded = !IsPulloutMenuOpen);

    private Task ToggleInventoryMovementMenuAsync() => ToggleMenuAsync("movement", _movementButton,
        () => _inventoryMovementMenuExpanded = !IsInventoryMovementMenuOpen);

    private async Task ToggleMenuAsync(string menu, ElementReference button, Action toggleExpanded)
    {
        if (!SidebarCollapsed)
        {
            toggleExpanded();
            return;
        }

        if (IsCollapsedFlyoutOpen(menu))
        {
            _collapsedFlyout = null;
            return;
        }

        _collapsedFlyoutTop = await JsRuntime.InvokeAsync<double>("godrejWms.getCollapsedNavFlyoutTop", button);
        _collapsedFlyout = menu;
    }

    private bool IsCollapsedFlyoutOpen(string menu) =>
        string.Equals(_collapsedFlyout, menu, StringComparison.Ordinal);

    private void CloseCollapsedFlyout() => _collapsedFlyout = null;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _collapsedFlyout = null;
        _inwardMenuExpanded = null;
        _pulloutMenuExpanded = null;
        _inventoryMovementMenuExpanded = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private bool IsInwardSection()
    {
        var path = NavManager.ToBaseRelativePath(NavManager.Uri).Trim('/');
        return path.Equals("inward", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("inward/", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsPulloutSection()
    {
        var path = NavManager.ToBaseRelativePath(NavManager.Uri).Trim('/');
        return path.Equals("pullout", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("pullout/", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsInventoryMovementSection()
    {
        var path = NavManager.ToBaseRelativePath(NavManager.Uri).Trim('/');
        return path.StartsWith("inventory-movement", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
}
