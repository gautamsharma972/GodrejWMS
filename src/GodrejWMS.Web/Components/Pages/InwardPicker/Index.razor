@page "/inward-picker"
@attribute [Authorize(Policy = "Permission:" + GodrejWMS.Application.Common.Permissions.PermissionKeys.Inward.AssignPkm)]
@using GodrejWMS.Application.Common
@using GodrejWMS.Application.Common.Models
@using GodrejWMS.Application.Features.AopDescriptionLocationPreferences.Dtos
@using GodrejWMS.Application.Features.AopDescriptionLocationPreferences.Queries
@using GodrejWMS.Application.Features.Inward.Commands
@using GodrejWMS.Application.Features.Inward.Dtos
@using GodrejWMS.Application.Features.Inward.Queries
@using GodrejWMS.Application.Features.Materials.Dtos
@using GodrejWMS.Application.Features.Materials.Queries
@using GodrejWMS.Domain.Entities
@using GodrejWMS.Domain.Enums
@inject IMediator Mediator
@inject GodrejWMS.Application.Common.Permissions.IPermissionService PermissionService
@inject IJSRuntime JsRuntime
@inject ILogger<Index> Logger

<PageTitle>Picker Put-away - Godrej WMS</PageTitle>

<div class="page-shell no-pkm-history-page">
    <div class="page-header">
        <div>
            <div class="eyebrow">Goods Receipt</div>
            <h1>Picker Put-away</h1>
            <p class="page-kicker">Open a GRN, then confirm or change the location, quantity and PKM of each suggested put-away location.</p>
        </div>
    </div>

    <div class="panel history-register">
        <div class="panel-header">
            <div>
                <h2 class="panel-title">Pending Transactions</h2>
                <p class="panel-subtitle">GRNs with put-away locations still to be worked.</p>
            </div>
            <div class="toolbar-group inward-history-header-actions">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadPageAsync(_pageNumber)">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    Refresh
                </button>
            </div>
        </div>
        <div class="toolbar-panel panel-toolbar history-toolbar">
            <div class="toolbar-group">
                <div class="input-group search-control">
                    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input class="form-control" placeholder="Search reference, vehicle, LR, material, or description"
                           @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                </div>
            </div>
            @if (_history is not null)
            {
                <span class="sync-chip">@_history.TotalCount.ToString("N0") @(_history.TotalCount == 1 ? "record" : "records")</span>
            }
        </div>
        @if (_history is null)
        {
            <div class="loading-panel">
                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                Loading...
            </div>
        }
        else if (_history.Items.Count == 0)
        {
            <div class="empty-state">No GRN is waiting for put-away.</div>
        }
        else
        {
            <div class="table-responsive history-table-wrap">
                <table class="table table-hover align-middle mb-0 history-table inward-history-table">
                    <thead>
                        <tr>
                            <th class="history-col-reference">Reference</th>
                            <th class="history-col-created">Created</th>
                            <th class="history-col-vehicle">Vehicle No.</th>
                            <th class="history-col-lr">LR No.</th>
                            <th class="history-col-status">Status</th>
                            <th class="history-col-status">Locations</th>
                            <th class="text-end history-number-column history-col-lines">Lines</th>
                            <th class="text-end history-number-column history-col-quantity">Boxes</th>
                            <th class="table-actions history-actions-column">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _history.Items)
                        {
                            <tr>
                                <td class="history-col-reference"><span class="record-code history-reference">@item.ReferenceNumber</span></td>
                                <td class="history-created history-col-created">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td class="history-col-vehicle" title="@item.VehicleNumber">@(string.IsNullOrWhiteSpace(item.VehicleNumber) ? "-" : item.VehicleNumber)</td>
                                <td class="history-col-lr" title="@item.LrNumber">@(string.IsNullOrWhiteSpace(item.LrNumber) ? "-" : item.LrNumber)</td>
                                <td class="history-col-status"><span class="status-pill @AllocationClass(item.Status)">@item.Status</span></td>
                                <td class="history-col-status"><span class="status-pill @SubmissionClass(item)">@SubmissionText(item)</span></td>
                                <td class="text-end history-number-column history-col-lines">@item.LineCount</td>
                                <td class="text-end fw-semibold history-number-column history-col-quantity">@item.TotalQuantityBoxes.ToString("N0")</td>
                                <td class="table-actions history-actions-column">
                                    <div class="history-row-actions">
                                        <button type="button" class="btn btn-sm btn-outline-primary table-action-btn" title="@($"Open {item.ReferenceNumber}")" aria-label="@($"Open {item.ReferenceNumber}")" @onclick="() => OpenDetailAsync(item.Id)">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="no-pkm-mobile-history-list">
                @foreach (var item in _history.Items)
                {
                    <article class="no-pkm-mobile-history-card">
                        <div class="no-pkm-mobile-history-main">
                            <span class="record-code">@item.ReferenceNumber</span>
                            <span class="status-pill @AllocationClass(item.Status)">@item.Status</span>
                        </div>
                        <div class="picker-submission-line">
                            <span class="status-pill @SubmissionClass(item)">@SubmissionText(item)</span>
                        </div>
                        <dl class="no-pkm-mobile-history-ids">
                            <div>
                                <dt>Vehicle No.</dt>
                                <dd>@(string.IsNullOrWhiteSpace(item.VehicleNumber) ? "-" : item.VehicleNumber)</dd>
                            </div>
                            <div>
                                <dt>LR No.</dt>
                                <dd>@(string.IsNullOrWhiteSpace(item.LrNumber) ? "-" : item.LrNumber)</dd>
                            </div>
                        </dl>
                        <div class="no-pkm-mobile-history-meta">
                            <span><i class="bi bi-clock" aria-hidden="true"></i>@item.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</span>
                            <span><strong>@item.LineCount</strong> line(s)</span>
                            <span><strong>@item.TotalQuantityBoxes.ToString("N0")</strong> boxes</span>
                        </div>
                        <div class="no-pkm-mobile-history-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenDetailAsync(item.Id)">
                                <i class="bi bi-eye" aria-hidden="true"></i> Open
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    @if (_history is not null && _history.Items.Count > 0)
    {
        <nav class="pagination-bar history-pagination" aria-label="Picker put-away pagination">
            <ul class="pagination mb-0">
                <li class="page-item @(_history.HasPreviousPage ? "" : "disabled")">
                    <button class="page-link" @onclick="() => LoadPageAsync(_pageNumber - 1)">Previous</button>
                </li>
                <li class="page-item disabled"><span class="page-link">Page @_history.PageNumber of @Math.Max(1, _history.TotalPages)</span></li>
                <li class="page-item @(_history.HasNextPage ? "" : "disabled")">
                    <button class="page-link" @onclick="() => LoadPageAsync(_pageNumber + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }

    @if (_isDetailOpen)
    {
        <div class="slide-over-backdrop" role="presentation" @onclick="CloseDetail">
            <div class="slide-over-panel picker-putaway-panel" role="dialog" aria-modal="true" aria-labelledby="picker-putaway-title" @onclick:stopPropagation="true">
                <div class="slide-over-header picker-putaway-header">
                    <div>
                        <div class="eyebrow">Goods Receipt</div>
                        <h2 id="picker-putaway-title" class="slide-over-title">@(_detail?.ReferenceNumber ?? "Loading...")</h2>
                        @if (_detail is not null)
                        {
                            <div class="picker-receipt-meta" aria-label="Receipt details">
                                <span><i class="bi bi-truck" aria-hidden="true"></i> Vehicle @(string.IsNullOrWhiteSpace(_detail.VehicleNumber) ? "-" : _detail.VehicleNumber)</span>
                                <span><i class="bi bi-receipt" aria-hidden="true"></i> LR @(string.IsNullOrWhiteSpace(_detail.LrNumber) ? "-" : _detail.LrNumber)</span>
                            </div>
                        }
                    </div>
                    <button type="button" class="slide-over-close" aria-label="Close detail" @onclick="CloseDetail">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="slide-over-body">
                    @if (!string.IsNullOrWhiteSpace(_detailError))
                    {
                        <div class="alert alert-danger mb-0">@_detailError</div>
                    }
                    else if (_detail is null)
                    {
                        <div class="loading-panel">
                            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                            Loading GRN details...
                        </div>
                    }
                    else
                    {
                        var rows = Rows();
                        var selected = _selectedPutawayId is { } sid ? rows.FirstOrDefault(r => r.Putaway.Id == sid) : null;
                        @if (_reviewMode != 0)
                        {
                            @ReviewForm
                        }
                        else if (selected is null)
                        {
                            var done = rows.Count(r => r.Done);
                            <p class="text-muted mb-2">Tap a location to confirm or change it. <strong>@done of @rows.Count</strong> done.</p>
                            <div class="picker-location-list d-grid gap-2">
                                @foreach (var row in rows)
                                {
                                    <button type="button" class="btn text-start border rounded-3 p-3 d-flex justify-content-between align-items-center @(row.Done ? "picker-location-done" : "btn-outline-primary")"
                                            disabled="@(row.Putaway.IsExcludedLocked || (!row.Posted && row.Putaway.IsConfirmed && !row.Putaway.IsPickerPlaced && row.Putaway.ExcludedLocation is null))" @onclick="() => SelectRow(row)">
                                        <span>
                                            <strong class="fs-5 @(row.Done ? "picker-location-code-done" : null)">@row.Putaway.LocationCode</strong><br />
                                            <span class="small text-muted">@row.Line.MaterialNumber &middot; @row.Putaway.QuantityBoxes.ToString("0.###") boxes &middot; @row.Line.MfgMonthLabel</span>
                                        </span>
                                        <span class="status-pill @(row.Done ? "success" : "warning")">@(row.Putaway.ExcludedLocation == "PICK-RESERVED" ? (row.Putaway.PlannedLocationCode ?? "Picked") : row.Putaway.ExcludedLocation is not null ? row.Putaway.ExcludedLocation : row.Putaway.IsPickerPlaced ? "Submitted" : row.Putaway.IsConfirmed && !row.Posted ? "Confirmed" : "To do")</span>
                                        @if (row.Putaway.IsVirtual) { <span class="status-pill info ms-1" title="Virtual overflow location">Virtual</span> }
                                    </button>
                                }
                            </div>
                            @if (_canConfirm)
                            {
                                @ReviewPanel
                            }
                            @if (rows.Any(r => !r.Putaway.IsExcludedLocked))
                            {
                                // The picker only submits; the final Confirm belongs to a supervisor. Until it is given every location stays editable.
                                @if (!_canConfirm)
                                {
                                    <div class="alert alert-info mt-3 mb-0" role="status">
                                        <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                                        @(done < rows.Count
                                            ? "Submit every location. A supervisor reviews and confirms the put-away afterwards."
                                            : "Every location is submitted. Waiting for the supervisor to review and confirm.")
                                    </div>
                                }
                                else
                                {
                                <div class="mt-3">
                                    @if (_confirmError is not null)
                                    {
                                        <div class="alert alert-danger" role="alert"><i class="bi bi-x-octagon" aria-hidden="true"></i> @_confirmError</div>
                                    }
                                    <button type="button" class="btn btn-primary btn-lg w-100" disabled="@(_confirming || done < rows.Count)" @onclick="ConfirmGrnAsync">
                                        <i class="bi bi-check2-all" aria-hidden="true"></i>
                                        @(_confirming ? "Saving..." : "Unloading Completed")
                                    </button>
                                    <p class="small text-muted mt-2 mb-0">
                                        @(done < rows.Count
                                            ? "Submit every location first, then press Unloading Completed. Until you do you can still change a location, its PKM or GIT / NO RACK."
                                            : "Until you confirm you can still change any location, its PKM or GIT / NO RACK.")
                                    </p>
                                </div>
                                }
                            }
                        }
                        else
                        {
                            <button type="button" class="picker-back-link" @onclick="BackToList">
                                <i class="bi bi-arrow-left" aria-hidden="true"></i> All locations
                            </button>
                            <div class="picker-putaway-workspace">
                                <section class="picker-location-summary" aria-labelledby="suggested-location-heading">
                                    <div class="picker-summary-icon" aria-hidden="true"><i class="bi bi-geo-alt"></i></div>
                                    <div class="picker-summary-content">
                                        <div id="suggested-location-heading" class="picker-section-label">Suggested location</div>
                                        <div class="picker-suggested-location">@selected.Putaway.LocationCode</div>
                                        <div class="picker-material-grid">
                                            <div>
                                                <span class="picker-detail-label">Material code</span>
                                                <strong>@selected.Line.MaterialNumber</strong>
                                            </div>
                                            <div>
                                                <span class="picker-detail-label">Description</span>
                                                <strong>@selected.Line.MaterialDescription</strong>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <section class="picker-putaway-form" aria-labelledby="putaway-details-heading">
                                    <div class="picker-form-heading">
                                        <div>
                                            <h3 id="putaway-details-heading">Put-away details</h3>
                                            <p>Confirm the quantity, PKM and destination.</p>
                                        </div>
                                        <span class="picker-required-note">All fields required</span>
                                    </div>

                                    <div class="picker-form-grid">
                                        <div class="picker-field picker-quantity-field">
                                            <label for="picker-qty">Quantity <span>(boxes)</span></label>
                                            <input id="picker-qty" type="number" inputmode="decimal" min="0" step="any" class="form-control form-control-lg" @bind="_qty" @bind:event="oninput" />
                                        </div>

                                        <fieldset class="picker-field picker-pkm-field">
                                            <legend>PKM</legend>
                                            <div class="picker-pkm-inputs">
                                                <select class="form-select form-select-lg" title="PKM year" aria-label="PKM year" @bind="_pkmYear">
                                                    <option value="0">Year</option>
                                                    @foreach (var year in YearOptions)
                                                    {
                                                        <option value="@year">@year</option>
                                                    }
                                                </select>
                                                <select class="form-select form-select-lg" title="PKM month" aria-label="PKM month" @bind="_pkmMonth">
                                                    <option value="0">Month</option>
                                                    @foreach (var month in MonthLabels)
                                                    {
                                                        <option value="@month.Value">@month.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        </fieldset>

                                        <div class="picker-field picker-location-field">
                                            <label>New location</label>
                                            <SearchableLocationSelect Options="_locationOptions" @bind-Value="_newLocationId" @bind-Value:after="OnLocationChanged"
                                                                      Placeholder="Search location, GIT or NO RACK" AriaLabel="Search new location" />
                                        </div>
                                    </div>

                                    @if (_submitError is not null)
                                    {
                                        <div class="alert alert-danger" role="alert"><i class="bi bi-x-octagon" aria-hidden="true"></i> @_submitError</div>
                                    }

                                    @if (_warning is not null)
                                    {
                                        <div class="alert alert-warning" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_warning</div>
                                    }

                                    <div class="picker-form-actions">
                                        <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="BackToList">Cancel</button>
                                        <button type="button" class="btn btn-primary btn-lg picker-submit-button" disabled="@(_submitting || !CanSubmit)" @onclick="SubmitAsync">
                                            <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                            @(_submitting ? "Submitting..." : _warning is null ? "Submit location" : "Submit anyway")
                                        </button>
                                    </div>
                                </section>
                            </div>
                        }
                    }
                </div>
                <div class="slide-over-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDetail">Close</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private RenderFragment ReviewPanel => __builder =>
    {
        var locked = _detail!.Lines.SelectMany(l => l.Putaways).Any(p => p.IsExcludedLocked && p.ExcludedLocation != "PICK-RESERVED");
        <section class="border rounded-3 p-3 mt-3" aria-labelledby="review-heading">
            <h3 id="review-heading" class="h6 mb-1">Damage, shortage, mismatch and excess</h3>
            <p class="small text-muted">Recorded against the put-away while you review it. Damaged boxes stay as Damage stock (in their location or the one you choose); excess is extra material found while unloading and goes to stock at the location you choose.</p>
            @if (_reviewError is not null)
            {
                <div class="alert alert-danger" role="alert">@_reviewError</div>
            }
            @foreach (var record in _detail.Variances ?? [])
            {
                <div class="d-flex justify-content-between align-items-start border-top py-2">
                    <div>
                        <span class="status-pill @(record.Type == InwardVarianceType.Excess ? "info" : record.Type == InwardVarianceType.Damage ? "danger" : "warning")">@record.Type</span>
                        <strong class="ms-2">@record.QuantityBoxes.ToString("0.###") boxes</strong>
                        <div class="small text-muted">@record.MaterialNumber &middot; @record.MfgMonthLabel &middot; @(record.FromLocationCode is null ? record.LocationCode : $"{record.FromLocationCode} → {record.LocationCode}")</div>
                        @if (record.ActualMaterialNumber is not null)
                        {
                            <div class="small text-muted">Arrived instead: @record.ActualMaterialNumber &middot; @record.ActualMfgMonthLabel</div>
                        }
                        <div class="small">@record.Remarks</div>
                    </div>
                    @if (!locked)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" title="Remove record" aria-label="Remove record" @onclick="() => RemoveRecordAsync(record.Id)">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    }
                </div>
            }
            @if (locked)
            {
                <p class="small text-muted mb-0">This GRN is confirmed, so records can no longer be changed.</p>
            }
            else
            {
                <div class="d-grid gap-2 mt-2">
                    <button type="button" class="btn btn-outline-primary" disabled="@(RecordableRows().Count == 0)" @onclick="OpenRecordForm">Record damage / shortage / mismatch</button>
                    <button type="button" class="btn btn-outline-primary" @onclick="OpenExcessForm">Add excess material</button>
                </div>
            }
        </section>
    };

    private RenderFragment ReviewForm => __builder =>
    {
        <button type="button" class="picker-back-link" @onclick="CloseReviewForm">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
        </button>
        @if (_reviewMode == 1)
        {
            <h3 class="h5">Damage / shortage / mismatch</h3>
            <div class="picker-form-grid">
                <div class="picker-field">
                    <label for="rec-row">Put-away</label>
                    <select id="rec-row" class="form-select form-select-lg" @bind="_recRowId">
                        <option value="0">Select put-away</option>
                        @foreach (var row in RecordableRows())
                        {
                            <option value="@row.Putaway.Id">@row.Putaway.LocationCode &middot; @row.Line.MaterialNumber &middot; @row.Line.MfgMonthLabel &middot; @row.Putaway.QuantityBoxes.ToString("0.###") boxes</option>
                        }
                    </select>
                </div>
                <div class="picker-field">
                    <label for="rec-type">Type</label>
                    <select id="rec-type" class="form-select form-select-lg" @bind="_recType">
                        <option value="@InwardVarianceType.Damage">Damage</option>
                        <option value="@InwardVarianceType.Shortage">Shortage</option>
                        <option value="@InwardVarianceType.Mismatch">Mismatch</option>
                    </select>
                </div>
                @if (_recType == InwardVarianceType.Mismatch)
                {
                    <div class="picker-field">
                        <label>Material code that arrived</label>
                        <SearchableMaterialSelect Options="_materials" @bind-Value="_actualMaterialId" Placeholder="Search material code or description" />
                    </div>
                    <fieldset class="picker-field picker-pkm-field">
                        <legend>PKM that arrived</legend>
                        <div class="picker-pkm-inputs">
                            <select class="form-select form-select-lg" title="PKM year" aria-label="PKM year that arrived" @bind="_actualYear">
                                <option value="0">Year</option>
                                @foreach (var year in YearOptions) { <option value="@year">@year</option> }
                            </select>
                            <select class="form-select form-select-lg" title="PKM month" aria-label="PKM month that arrived" @bind="_actualMonth">
                                <option value="0">Month</option>
                                @foreach (var month in MonthLabels) { <option value="@month.Value">@month.Label</option> }
                            </select>
                        </div>
                    </fieldset>
                }
                <div class="picker-field picker-quantity-field">
                    <label for="rec-qty">Quantity <span>(boxes)</span></label>
                    <input id="rec-qty" type="number" inputmode="decimal" min="0" step="any" class="form-control form-control-lg" @bind="_recQty" @bind:event="oninput" />
                </div>
                @if (_recType != InwardVarianceType.Shortage)
                {
                    <div class="picker-field picker-location-field">
                        <label>Location <span>(put these boxes in - leave empty to keep them in the put-away's own location)</span></label>
                        <SearchableLocationSelect Options="_realLocationOptions" @bind-Value="_destinationId" Placeholder="Search location" AriaLabel="Search location for these boxes" />
                    </div>
                }
                <div class="picker-field">
                    <label for="rec-remarks">Remark</label>
                    <input id="rec-remarks" class="form-control form-control-lg" maxlength="500" placeholder="What was found" @bind="_recRemarks" @bind:event="oninput" />
                </div>
            </div>
            @if (_reviewError is not null)
            {
                <div class="alert alert-danger" role="alert">@_reviewError</div>
            }
            <div class="picker-form-actions">
                <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CloseReviewForm">Cancel</button>
                <button type="button" class="btn btn-primary btn-lg" disabled="@(_reviewSaving || !CanSaveRecord)" @onclick="SaveRecordAsync">
                    @(_reviewSaving ? "Saving..." : "Save record")
                </button>
            </div>
        }
        else
        {
            <h3 class="h5">Add excess material</h3>
            <div class="picker-form-grid">
                <div class="picker-field">
                    <label>Material code</label>
                    <SearchableMaterialSelect Options="_materials" @bind-Value="_exMaterialId" Placeholder="Search material code or description" />
                </div>
                <fieldset class="picker-field picker-pkm-field">
                    <legend>PKM</legend>
                    <div class="picker-pkm-inputs">
                        <select class="form-select form-select-lg" title="PKM year" aria-label="PKM year" @bind="_exYear">
                            <option value="0">Year</option>
                            @foreach (var year in YearOptions) { <option value="@year">@year</option> }
                        </select>
                        <select class="form-select form-select-lg" title="PKM month" aria-label="PKM month" @bind="_exMonth">
                            <option value="0">Month</option>
                            @foreach (var month in MonthLabels) { <option value="@month.Value">@month.Label</option> }
                        </select>
                    </div>
                </fieldset>
                <div class="picker-field picker-location-field">
                    <label>Location</label>
                    <SearchableLocationSelect Options="_realLocationOptions" @bind-Value="_exLocationId" Placeholder="Search location" AriaLabel="Search location for the excess material" />
                </div>
                <div class="picker-field picker-quantity-field">
                    <label for="ex-qty">Quantity <span>(boxes)</span></label>
                    <input id="ex-qty" type="number" inputmode="decimal" min="0" step="any" class="form-control form-control-lg" @bind="_exQty" @bind:event="oninput" />
                </div>
                <div class="picker-field">
                    <label for="ex-remarks">Remark</label>
                    <input id="ex-remarks" class="form-control form-control-lg" maxlength="500" placeholder="Where it was found" @bind="_exRemarks" @bind:event="oninput" />
                </div>
            </div>
            @if (_reviewWarning is not null)
            {
                <div class="alert alert-warning" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_reviewWarning</div>
            }
            @if (_reviewError is not null)
            {
                <div class="alert alert-danger" role="alert">@_reviewError</div>
            }
            <div class="picker-form-actions">
                <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CloseReviewForm">Cancel</button>
                <button type="button" class="btn btn-primary btn-lg" disabled="@(_reviewSaving || !CanSaveExcess)" @onclick="() => SaveExcessAsync(_reviewWarning is not null)">
                    @(_reviewSaving ? "Saving..." : _reviewWarning is null ? "Save excess material" : "Save anyway")
                </button>
            </div>
        }
    };

    // ---- supervisor review: damage / shortage / mismatch / excess
    private int _reviewMode; // 0 = none, 1 = damage/shortage/mismatch form, 2 = excess form
    private IReadOnlyList<MaterialDto> _materials = [];
    private IReadOnlyList<AopLocationOptionDto> _realLocationOptions = [];
    private string? _reviewError;
    private string? _reviewWarning;
    private bool _reviewSaving;
    private int _recRowId;
    private InwardVarianceType _recType = InwardVarianceType.Damage;
    private decimal _recQty;
    private string _recRemarks = string.Empty;
    private int _actualMaterialId;
    private int _actualYear;
    private int _actualMonth;
    private int _destinationId;
    private int _exMaterialId;
    private int _exYear;
    private int _exMonth;
    private int _exLocationId;
    private decimal _exQty;
    private string _exRemarks = string.Empty;

    private bool CanSaveRecord => _recRowId > 0 && _recQty > 0 && !string.IsNullOrWhiteSpace(_recRemarks)
        && (_recType != InwardVarianceType.Mismatch || (_actualMaterialId > 0 && _actualYear > 0 && _actualMonth > 0));

    private bool CanSaveExcess => _exMaterialId > 0 && _exYear > 0 && _exMonth > 0 && _exLocationId > 0 && _exQty > 0 && !string.IsNullOrWhiteSpace(_exRemarks);

    private List<PutawayRow> RecordableRows() => Rows().Where(r => r.Putaway.ExcludedLocation is null && r.Putaway.QuantityBoxes > 0 && (r.Putaway.IsConfirmed || r.Putaway.IsPickerPlaced)).ToList();

    private static string PkmText(int year, int month) =>
        $"{System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(month).ToUpperInvariant()}|{year}";

    private async Task EnsureReviewDataAsync()
    {
        if (_materials.Count == 0)
        {
            _materials = (await SendAsync(new GetMaterialsQuery(IsActive: true, PageSize: 5000))).Items;
        }

        _realLocationOptions = _locationOptions.Where(o => o.Id > 0).ToList();
    }

    private async Task OpenRecordForm()
    {
        await EnsureReviewDataAsync();
        _recRowId = 0; _recType = InwardVarianceType.Damage; _recQty = 0; _recRemarks = string.Empty;
        _actualMaterialId = 0; _actualYear = 0; _actualMonth = 0; _destinationId = 0;
        _reviewError = null; _reviewWarning = null;
        _reviewMode = 1;
    }

    private async Task OpenExcessForm()
    {
        await EnsureReviewDataAsync();
        _exMaterialId = 0; _exYear = 0; _exMonth = 0; _exLocationId = 0; _exQty = 0; _exRemarks = string.Empty;
        _reviewError = null; _reviewWarning = null;
        _reviewMode = 2;
    }

    private void CloseReviewForm()
    {
        _reviewMode = 0;
        _reviewError = null;
        _reviewWarning = null;
    }

    private async Task ReloadDetailAsync()
    {
        if (_detail is not null)
        {
            _detail = await SendAsync(new GetInwardDetailQuery(_detail.Id));
        }
    }

    private async Task SaveRecordAsync()
    {
        if (_reviewSaving || !CanSaveRecord) return;
        _reviewSaving = true;
        _reviewError = null;
        try
        {
            var mismatch = _recType == InwardVarianceType.Mismatch;
            await SendAsync(new RecordInwardVarianceCommand(
                _recRowId, _recType, _recQty, _recRemarks.Trim(),
                mismatch ? _actualMaterialId : null,
                mismatch ? PkmText(_actualYear, _actualMonth) : null,
                _recType != InwardVarianceType.Shortage && _destinationId > 0 ? _destinationId : null));
            await ReloadDetailAsync();
            CloseReviewForm();
        }
        catch (Exception ex)
        {
            _reviewError = ex.Message;
        }
        finally
        {
            _reviewSaving = false;
        }
    }

    private async Task SaveExcessAsync(bool acknowledgeWarning)
    {
        if (_reviewSaving || _detail is null || !CanSaveExcess) return;
        _reviewSaving = true;
        _reviewError = null;
        try
        {
            var result = await SendAsync(new RecordExcessMaterialCommand(
                _detail.Id, _exMaterialId, PkmText(_exYear, _exMonth), _exLocationId, _exQty, _exRemarks.Trim(), acknowledgeWarning));
            if (!result.Saved)
            {
                _reviewWarning = result.Warning ?? "Check the location.";
                return;
            }

            await ReloadDetailAsync();
            CloseReviewForm();
        }
        catch (Exception ex)
        {
            _reviewError = ex.Message;
        }
        finally
        {
            _reviewSaving = false;
        }
    }

    private async Task RemoveRecordAsync(int varianceId)
    {
        _reviewError = null;
        try
        {
            await SendAsync(new RemoveInwardVarianceCommand(varianceId));
            await ReloadDetailAsync();
        }
        catch (Exception ex)
        {
            _reviewError = ex.Message;
        }
    }

    private const int GitOptionId = -1;
    private const int NoRackOptionId = -2;

    private PaginatedList<InwardHistoryDto>? _history;
    private int _pageNumber = 1;
    private string _search = string.Empty;
    private bool _loading;
    private bool _reloadQueued;

    private bool _isDetailOpen;
    private InwardDetailDto? _detail;
    private string? _detailError;
    private string? _submitError;
    private string? _confirmError;
    private bool _confirming;
    private bool _canConfirm;
    private int? _selectedPutawayId;

    private IReadOnlyList<AopLocationOptionDto> _locationOptions = [];
    private decimal _qty;
    private int _pkmYear;
    private int _pkmMonth;
    private int _newLocationId;
    private string? _warning;
    private bool _submitting;

    /// <param name="Posted">The GRN was posted to inventory on upload: stock is already at the suggested location and
    /// the picker only has to confirm or change it, so a row is done once the picker has submitted it.</param>
    private sealed record PutawayRow(InwardDetailLineDto Line, InwardPutawayDto Putaway, bool Posted)
    {
        public bool Done => Putaway.IsPickerPlaced || (!Posted && Putaway.IsConfirmed);
    }

    private static readonly (int Value, string Label)[] MonthLabels =
        Enumerable.Range(1, 12).Select(m => (m, System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(m).ToUpperInvariant())).ToArray();

    private static IEnumerable<int> YearOptions => Enumerable.Range(DateTime.Today.Year - 3, 5);

    private bool CanSubmit => _qty > 0 && _newLocationId != 0 && (_newLocationId == NoRackOptionId || (_pkmYear > 0 && _pkmMonth > 0));

    private List<PutawayRow> Rows() => _detail is null ? [] :
        _detail.Lines.SelectMany(l => l.Putaways.Select(p => new PutawayRow(l, p, _detail.PostedAt.HasValue)))
            .OrderBy(r => r.Done)
            .ThenBy(r => r.Putaway.LocationCode, StringComparer.Ordinal)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _canConfirm = await PermissionService.HasPermissionAsync(GodrejWMS.Application.Common.Permissions.PermissionKeys.Inward.Confirm);
        var options = (await SendAsync(new GetAopLocationOptionsQuery())).ToList();
        options.Insert(0, new AopLocationOptionDto(NoRackOptionId, 0, "", 0, "", 0, 0, "NO RACK"));
        options.Insert(0, new AopLocationOptionDto(GitOptionId, 0, "", 0, "", 0, 0, "GIT"));
        _locationOptions = options;
        await LoadPageAsync(1);
    }

    // Every database call on this page goes through here: the circuit shares one DbContext, so two overlapping
    // requests (e.g. opening a GRN while the list or the material lookup is still loading) must queue, not run together.
    private readonly SemaphoreSlim _dbGate = new(1, 1);

    private async Task<TResponse> SendAsync<TResponse>(MediatR.IRequest<TResponse> request)
    {
        await _dbGate.WaitAsync();
        try
        {
            return await Mediator.Send(request);
        }
        finally
        {
            _dbGate.Release();
        }
    }

    // Blazor Server shares one DbContext per circuit: never run two queries at once (see Inward (No PKM) History).
    private async Task LoadPageAsync(int page)
    {
        if (page < 1) return;
        _pageNumber = page;
        if (_loading)
        {
            _reloadQueued = true;
            return;
        }

        _loading = true;
        try
        {
            do
            {
                _reloadQueued = false;
                _history = await SendAsync(new GetPickerPendingInwardQuery(_search, _pageNumber, 10));
            }
            while (_reloadQueued);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) => await LoadPageAsync(1);

    private static bool AllSubmitted(InwardHistoryDto item) => item.LocationCount > 0 && item.SubmittedLocationCount >= item.LocationCount;

    private static string SubmissionClass(InwardHistoryDto item) => AllSubmitted(item) ? "success" : item.SubmittedLocationCount > 0 ? "warning" : "danger";

    private static string SubmissionText(InwardHistoryDto item) => item.LocationCount == 0
        ? "No locations"
        : AllSubmitted(item) ? "All submitted" : $"{item.SubmittedLocationCount} of {item.LocationCount} submitted";

    private static string AllocationClass(AllocationStatus status) => status switch
    {
        AllocationStatus.Fulfilled => "success",
        AllocationStatus.Partial => "warning",
        _ => "danger"
    };

    private async Task OpenDetailAsync(int id)
    {
        _detail = null;
        _detailError = null;
        _selectedPutawayId = null;
        _isDetailOpen = true;
        try
        {
            _detail = await SendAsync(new GetInwardDetailQuery(id));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to load GRN {TransactionId} for picker put-away", id);
            _detailError = ex.Message;
        }
    }

    private void CloseDetail()
    {
        _isDetailOpen = false;
        _confirmError = null;
        _detail = null;
        _detailError = null;
        _selectedPutawayId = null;
        _reviewMode = 0;
        _reviewError = null;
    }

    private void SelectRow(PutawayRow row)
    {
        _selectedPutawayId = row.Putaway.Id;
        _qty = row.Putaway.QuantityBoxes;
        _warning = null;
        _submitError = null;
        _newLocationId = row.Putaway.ExcludedLocation switch { "GIT" => GitOptionId, "NO RACK" => NoRackOptionId, _ => row.Putaway.PalletPositionId };
        if (MfgMonthParser.TryParse(row.Line.MfgMonthLabel, out var pkm))
        {
            _pkmYear = pkm / 100;
            _pkmMonth = pkm % 100;
        }
        else
        {
            _pkmYear = 0;
            _pkmMonth = 0;
        }
    }

    private void BackToList()
    {
        _selectedPutawayId = null;
        _warning = null;
        _submitError = null;
    }

    // Picking another location invalidates a warning that was raised for the previous one.
    private void OnLocationChanged() => _warning = null;

    private async Task ConfirmGrnAsync()
    {
        if (_detail is null || _confirming) return;

        _confirming = true;
        _confirmError = null;
        try
        {
            var result = await SendAsync(new ConfirmPickerPutawayCommand(_detail.Id));
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast",
                $"{result.ReferenceNumber} put-away confirmed and inventory updated.", "success");
            CloseDetail();
            await LoadPageAsync(_pageNumber);
        }
        catch (Exception ex)
        {
            _confirmError = ex.Message;
        }
        finally
        {
            _confirming = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_detail is null || _selectedPutawayId is not { } id || !CanSubmit) return;

        var excluded = _newLocationId switch { GitOptionId => "GIT", NoRackOptionId => "NO RACK", _ => null };
        var pkmText = excluded != "NO RACK" && _pkmYear > 0 && _pkmMonth > 0 ? $"{MonthLabels[_pkmMonth - 1].Label}|{_pkmYear}" : null;
        _submitting = true;
        _submitError = null;
        try
        {
            var result = await SendAsync(new PickerPlaceInwardPutawayCommand(
                id, _qty, pkmText, excluded is null ? _newLocationId : null, excluded, AcknowledgeWarning: _warning is not null));
            if (!result.Saved)
            {
                _warning = result.Warning;
                return;
            }

            _warning = null;
            _selectedPutawayId = null;
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast", excluded is null ? "Put-away location saved." : $"Set aside as {excluded}.", "success");
            _detail = await SendAsync(new GetInwardDetailQuery(_detail.Id));
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast", ex.Message, "danger");
        }
        finally
        {
            _submitting = false;
        }
    }
}
