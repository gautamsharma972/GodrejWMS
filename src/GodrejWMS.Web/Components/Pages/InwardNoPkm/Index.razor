@page "/inward-no-pkm"
@attribute [Authorize(Policy = "Permission:" + GodrejWMS.Application.Common.Permissions.PermissionKeys.Menu.ViewInwardNoPkm)]
@implements IAsyncDisposable
@using GodrejWMS.Application.Common.Exceptions
@using GodrejWMS.Application.Common.Interfaces
@using GodrejWMS.Application.Features.Inward.Commands
@using GodrejWMS.Application.Features.Inward.Dtos
@using GodrejWMS.Application.Features.Inward.Queries
@using GodrejWMS.Application.Features.Materials.Dtos
@using GodrejWMS.Application.Features.Materials.Queries
@using GodrejWMS.Application.Features.Racks.Dtos
@using GodrejWMS.Application.Features.Racks.Queries
@using GodrejWMS.Domain.Enums
@inject IMediator Mediator
@inject IExcelService ExcelService
@inject IJSRuntime JsRuntime
@inject ILogger<Index> Logger

<PageTitle>Inward (No PKM) - Godrej WMS</PageTitle>

<div class="page-shell no-pkm-entry-page">
    <div class="page-header">
        <div>
            <div class="eyebrow">Goods Receipt - No PKM</div>
            <h1>Inward Entry (No PKM)</h1>
            <p class="page-kicker">Record stock arrivals that don't have a manufacturing month/batch yet. These go straight into empty pallet positions and need a PKM assigned before they can be confirmed into stock.</p>
        </div>
        <div class="header-actions">
            <span class="sync-chip"><span class="live-dot"></span> Allocation ready</span>
        </div>
    </div>

    <div class="toolbar-panel">
        <div class="toolbar-group">
            <label class="form-label mb-0">Warehouse <span class="required-indicator" aria-hidden="true">*</span></label>
            <WarehouseSelect @bind-WarehouseId="_warehouseId" />
        </div>
    </div>

    <div class="transaction-grid inward-entry-grid">
        <div class="panel inward-entry-panel inward-manual-panel">
            <div class="panel-header">
                <div>
                    <h2 class="panel-title">Manual Lines</h2>
                    <p class="panel-subtitle">Select material and quantity. No PKM/Mfg Month needed here.</p>
                </div>
            </div>
            <div class="panel-body line-editor-body">
                <div class="table-responsive line-editor-table">
                    <table class="table line-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Material Code</th>
                                <th>Qty (boxes)</th>
                                <th class="table-actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < _lines.Count; i++)
                            {
                                var index = i;
                                <tr>
                                    <td>
                                        <div class="material-combobox">
                                            <input class="@LineFieldClass(index, nameof(LineModel.MaterialCodeText), "form-control")"
                                                   autocomplete="off"
                                                   placeholder="Search material code or description"
                                                   @bind-value="_lines[index].MaterialCodeText"
                                                   @bind-value:event="oninput"
                                                   @bind-value:after="() => ClearLineFieldError(index, nameof(LineModel.MaterialCodeText))"
                                                   aria-invalid="@HasLineFieldError(index, nameof(LineModel.MaterialCodeText))"
                                                   @onfocus="() => _activeMaterialLineIndex = index" />
                                            @if (_activeMaterialLineIndex == index)
                                            {
                                                var matches = MaterialMatches(_lines[index].MaterialCodeText).ToList();
                                                if (matches.Count > 0)
                                                {
                                                    <div class="material-menu">
                                                        @foreach (var material in matches)
                                                        {
                                                            <button type="button" class="material-option" @onclick="() => SelectMaterial(index, material)">
                                                                <span class="record-code">@material.MaterialNumber</span>
                                                                <span>@material.Description</span>
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                        @LineFieldError(index, nameof(LineModel.MaterialCodeText))
                                    </td>
                                    <td>
                                        <input class="@LineFieldClass(index, nameof(LineModel.QuantityBoxes), "form-control")"
                                               type="number"
                                               step="1"
                                               min="1"
                                               @bind="_lines[index].QuantityBoxes"
                                               @bind:after="() => ClearLineFieldError(index, nameof(LineModel.QuantityBoxes))"
                                               aria-invalid="@HasLineFieldError(index, nameof(LineModel.QuantityBoxes))" />
                                        @LineFieldError(index, nameof(LineModel.QuantityBoxes))
                                    </td>
                                    <td class="table-actions">
                                        <button class="btn btn-sm btn-outline-danger" title="Remove line" aria-label="Remove line" @onclick="() => RemoveLine(index)">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="toolbar-group line-editor-actions">
                    <button class="btn btn-outline-secondary" @onclick="AddLine">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        Add Line
                    </button>
                    <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@_submitting">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        Submit Inward
                    </button>
                </div>
            </div>
        </div>

        <div class="panel inward-entry-panel inward-upload-panel">
            <div class="panel-header">
                <div>
                    <h2 class="panel-title">Bulk Upload</h2>
                    <p class="panel-subtitle">Same Unloading Sheet workbook format as Inward - any Pkd/Batch value on the sheet is ignored.</p>
                </div>
            </div>
            <div class="panel-body upload-panel">
                <InputFile id="inward-no-pkm-excel-upload" OnChange="OnImportFileSelected" class="visually-hidden" />
                <div class="bulk-upload-actions">
                    <label class="btn btn-outline-primary" for="inward-no-pkm-excel-upload">
                        <i class="bi bi-upload" aria-hidden="true"></i>
                        Upload Excel
                    </label>
                    <button type="button" class="btn btn-outline-secondary" @onclick="DownloadSampleFormatAsync">
                        <i class="bi bi-download" aria-hidden="true"></i>
                        Sample Format
                    </button>
                </div>
                <div class="upload-guidance">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    <span>One GRN per sheet, same layout as the regular Inward upload. Maximum file size: 10 MB.</span>
                </div>
            </div>
        </div>
    </div>

    <div class="putaway-info-bar" role="status">
        <div class="info-bar-icon">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
        </div>
        <div class="info-bar-content">
            <h2>Put-away Logic</h2>
            <p>Every box here goes straight to an empty pallet position (no same-SKU top-up or same-rack consolidation is possible without a PKM), ranked by the same zone/velocity/season preferences as a normal inward.</p>
        </div>
        <span class="status-pill info">Empty pallets only</span>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger mb-0">@_error</div>
    }

    @if (_workbookOutcomes is not null)
    {
        var created = _workbookOutcomes.Count(o => o.Status == InwardSheetImportStatus.Created);
        <div class="result-ready-bar">
            <div class="info-bar-icon">
                <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>
            </div>
            <div class="info-bar-content">
                <h2>Workbook processed</h2>
                <p>@created of @_workbookOutcomes.Count sheet(s) created as new GRNs - see the summary for what was skipped or failed.</p>
            </div>
            <button type="button" class="btn btn-primary" @onclick="() => _isWorkbookResultModalOpen = true">
                <i class="bi bi-eye" aria-hidden="true"></i>
                View Summary
            </button>
        </div>
    }

    @if (_workbookOutcomes is not null && _isWorkbookResultModalOpen)
    {
        <div class="slide-over-backdrop" role="presentation" @onclick="CloseWorkbookResultModal">
            <div class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="inward-no-pkm-workbook-result-title" @onclick:stopPropagation="true">
                <div class="slide-over-header">
                    <div>
                        <div class="eyebrow">Multi-Sheet Upload</div>
                        <h2 id="inward-no-pkm-workbook-result-title" class="slide-over-title">Workbook Import Summary</h2>
                        <p class="slide-over-subtitle">@_workbookOutcomes.Count(o => o.Status == InwardSheetImportStatus.Created) of @_workbookOutcomes.Count sheet(s) created</p>
                    </div>
                    <button type="button" class="slide-over-close" aria-label="Close summary" @onclick="CloseWorkbookResultModal">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="slide-over-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Sheet</th>
                                    <th>Outcome</th>
                                    <th>Reference</th>
                                    <th>Message</th>
                                    <th class="table-actions history-actions-column">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var outcome in _workbookOutcomes)
                                {
                                    <tr>
                                        <td>@outcome.SheetName</td>
                                        <td><span class="status-pill @WorkbookOutcomePillClass(outcome.Status)">@WorkbookOutcomeLabel(outcome.Status)</span></td>
                                        <td>@(outcome.ReferenceNumber ?? "—")</td>
                                        <td>@outcome.Message</td>
                                        <td class="table-actions history-actions-column">
                                            @if (outcome.Status == InwardSheetImportStatus.Created && outcome.ReferenceNumber is not null)
                                            {
                                                <div class="history-row-actions">
                                                    <button type="button" class="btn btn-sm btn-outline-primary table-action-btn" title="@($"View {outcome.ReferenceNumber}")" aria-label="@($"View {outcome.ReferenceNumber}")" @onclick="() => OpenWorkbookGrnDetailAsync(outcome.ReferenceNumber)">
                                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary table-action-btn history-download-btn" title="@($"Download Excel {outcome.ReferenceNumber}")" aria-label="@($"Download Excel {outcome.ReferenceNumber}")" @onclick="() => DownloadWorkbookGrnExcelAsync(outcome.ReferenceNumber)">
                                                        <i class="bi bi-file-earmark-excel" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_isWorkbookGrnDetailOpen)
    {
        <div class="slide-over-backdrop" role="presentation" @onclick="CloseWorkbookGrnDetail">
            <div class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="inward-no-pkm-grn-detail-title" @onclick:stopPropagation="true">
                <div class="slide-over-header">
                    <div>
                        <div class="eyebrow">Goods Receipt</div>
                        <h2 id="inward-no-pkm-grn-detail-title" class="slide-over-title">@(_workbookGrnDetail?.ReferenceNumber ?? "Loading...")</h2>
                        <p class="slide-over-subtitle">Flagged "PKM needed" until someone assigns a PKM and confirms it.</p>
                    </div>
                    <button type="button" class="slide-over-close" aria-label="Close detail" @onclick="CloseWorkbookGrnDetail">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="slide-over-body">
                    @if (!string.IsNullOrWhiteSpace(_workbookGrnDetailError))
                    {
                        <div class="alert alert-danger mb-0">@_workbookGrnDetailError</div>
                    }
                    else if (_workbookGrnDetail is null)
                    {
                        <div class="loading-panel">
                            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                            Loading GRN details...
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Material</th>
                                        <th class="text-end">Requested</th>
                                        <th class="text-end">Allocated</th>
                                        <th>Status</th>
                                        <th>Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in _workbookGrnDetail.Lines)
                                    {
                                        @if (line.Putaways.Count == 0)
                                        {
                                            <tr>
                                                <td><span class="record-code">@line.MaterialNumber</span> @line.MaterialDescription</td>
                                                <td class="text-end">@line.RequestedQuantityBoxes</td>
                                                <td class="text-end fw-semibold">@line.AllocatedQuantityBoxes.ToString("0.###")</td>
                                                <td><span class="status-pill @AllocationClass(line.Status)">@line.Status</span> @line.Remarks</td>
                                                <td><span class="text-muted small">No location reserved</span></td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var putaway in line.Putaways)
                                            {
                                                <tr>
                                                    <td><span class="record-code">@line.MaterialNumber</span> @line.MaterialDescription</td>
                                                    <td class="text-end">@line.RequestedQuantityBoxes</td>
                                                    <td class="text-end fw-semibold">@line.AllocatedQuantityBoxes.ToString("0.###")</td>
                                                    <td><span class="status-pill @AllocationClass(line.Status)">@line.Status</span> @line.Remarks</td>
                                                    <td>@putaway.LocationCode <strong>+@putaway.QuantityBoxes.ToString("0.###")</strong></td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="slide-over-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseWorkbookGrnDetail">Close</button>
                    @if (_workbookGrnDetail is not null)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => DownloadDetailExcelAsync(_workbookGrnDetail)">
                            <i class="bi bi-file-earmark-excel" aria-hidden="true"></i>
                            Download Excel
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    @if (_result is not null)
    {
        <div class="result-ready-bar">
            <div class="info-bar-icon">
                <i class="bi bi-clipboard-check" aria-hidden="true"></i>
            </div>
            <div class="info-bar-content">
                <h2>Allocation result generated</h2>
                <p>Reference @_result.ReferenceNumber has reserved locations - flagged "PKM needed" for whoever confirms it.</p>
            </div>
            <button type="button" class="btn btn-primary" @onclick="OpenResultModal">
                <i class="bi bi-eye" aria-hidden="true"></i>
                View Allocation Result
            </button>
        </div>
    }

    @if (_result is not null && _isResultModalOpen)
    {
        <div class="slide-over-backdrop" role="presentation" @onclick="CloseResultModal">
            <div class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="allocation-result-title" @onclick:stopPropagation="true">
                <div class="slide-over-header">
                    <div>
                        <div class="eyebrow">Put-away Allocation Audit</div>
                        <h2 id="allocation-result-title" class="slide-over-title">Allocation Result</h2>
                        <p class="slide-over-subtitle">Reference @_result.ReferenceNumber</p>
                    </div>
                    <button type="button" class="slide-over-close" aria-label="Close allocation result" @onclick="CloseResultModal">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="slide-over-body">
                    <div class="toolbar-panel panel-toolbar pick-result-toolbar">
                        <div class="toolbar-group">
                            <select class="form-select filter-control" @bind="_statusFilter">
                                <option value="">All statuses</option>
                                @foreach (var status in Enum.GetValues<AllocationStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <span class="count-pill">@DisplayResultAllocationRows.Count() line(s)</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th><button class="sort-button" @onclick='@(() => SortBy("material"))'>Material <i class='bi @SortIcon("material")'></i></button></th>
                                    <th class="text-end"><button class="sort-button" @onclick='@(() => SortBy("requested"))'>Requested <i class='bi @SortIcon("requested")'></i></button></th>
                                    <th class="text-end"><button class="sort-button" @onclick='@(() => SortBy("allocated"))'>Allocated <i class='bi @SortIcon("allocated")'></i></button></th>
                                    <th><button class="sort-button" @onclick='@(() => SortBy("status"))'>Status <i class='bi @SortIcon("status")'></i></button></th>
                                    <th><button class="sort-button" @onclick='@(() => SortBy("pallet"))'>Location <i class='bi @SortIcon("pallet")'></i></button></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in DisplayResultAllocationRows)
                                {
                                    <tr>
                                        <td><span class="record-code">@row.Line.MaterialNumber</span> @row.Line.MaterialDescription</td>
                                        <td class="text-end">@row.Line.RequestedQuantityBoxes</td>
                                        <td class="text-end fw-semibold">@row.AllocatedQuantityBoxes.ToString("0.###")</td>
                                        <td>
                                            <span class="status-pill @AllocationClass(row.Line.Status)">
                                                @row.Line.Status
                                            </span>
                                            @row.Line.Remarks
                                        </td>
                                        <td>
                                            @if (row.Allocation is null)
                                            {
                                                <span class="text-muted small">No location reserved</span>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="allocation-location-pill"
                                                        title="@AllocationPillTitle(row.Allocation)"
                                                        @onclick="() => OpenPalletDetailsAsync(row.Allocation.LocationCode)">
                                                    <span>@row.Allocation.LocationCode</span>
                                                    <strong>+@row.Allocation.QuantityBoxes.ToString("0.###")</strong>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="slide-over-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseResultModal">Close</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="DownloadResultExcelAsync">
                        <i class="bi bi-file-earmark-excel" aria-hidden="true"></i>
                        Download Excel
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_isPalletDetailsOpen)
    {
        <div class="slide-over-backdrop" role="presentation" @onclick="ClosePalletDetails">
            <div class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="pallet-detail-title" @onclick:stopPropagation="true">
                <div class="slide-over-header">
                    <div>
                        <div class="eyebrow">Pallet Position</div>
                        <h2 id="pallet-detail-title" class="slide-over-title">Pallet Details</h2>
                        <p class="slide-over-subtitle">@(_selectedPalletPosition?.LocationCode ?? "Loading location details")</p>
                    </div>
                    <button type="button" class="slide-over-close" aria-label="Close pallet details" @onclick="ClosePalletDetails">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="slide-over-body">
                    @if (!string.IsNullOrWhiteSpace(_palletDetailsError))
                    {
                        <div class="alert alert-danger mb-0">@_palletDetailsError</div>
                    }
                    else if (_selectedPalletPosition is null)
                    {
                        <div class="loading-panel">
                            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                            Loading pallet details...
                        </div>
                    }
                    else
                    {
                        <div class="position-detail-shell">
                            <div class="position-summary-card">
                                <div class="position-summary-top">
                                    <div>
                                        <div class="eyebrow">Location</div>
                                        <h2>@_selectedPalletPosition.LocationCode</h2>
                                    </div>
                                    <span class="status-pill @(_selectedPalletPosition.IsActive ? "success" : "inactive")">@(_selectedPalletPosition.IsActive ? "Active" : "Inactive")</span>
                                </div>

                                <div class="position-tag-row">
                                    <span class="status-pill info">@_selectedPalletPosition.LocationTypeName</span>
                                    <span class="status-pill @SubtypeClass(_selectedPalletPosition.LocationSubtypeCode)">@_selectedPalletPosition.LocationSubtypeName</span>
                                    <span class="status-pill @ZoneClass(_selectedPalletPosition.ZoneTypeCode)">@_selectedPalletPosition.ZoneTypeName</span>
                                </div>

                                <div class="position-progress-block">
                                    <div>
                                        <span>Occupied</span>
                                        <strong>@_selectedPalletPosition.OccupiedBoxes.ToString("0.###") / @(_selectedPalletPosition.CapacityBoxes?.ToString() ?? "—") boxes</strong>
                                    </div>
                                    <span>@OccupancyPercent(_selectedPalletPosition).ToString("0.#")%</span>
                                </div>
                                <div class="position-progress-track">
                                    <span style="@($"width:{OccupancyPercent(_selectedPalletPosition):0.##}%")"></span>
                                </div>
                            </div>

                            <div class="position-metric-grid">
                                <div class="position-metric">
                                    <span>Capacity</span>
                                    <strong>@(_selectedPalletPosition.CapacityBoxes?.ToString() ?? "—")</strong>
                                </div>
                                <div class="position-metric">
                                    <span>Occupied</span>
                                    <strong>@_selectedPalletPosition.OccupiedBoxes.ToString("0.###")</strong>
                                </div>
                                <div class="position-metric success">
                                    <span>Free</span>
                                    <strong>@(_selectedPalletPosition.FreeBoxes?.ToString("0.###") ?? "—")</strong>
                                </div>
                                <div class="position-metric">
                                    <span>Priority</span>
                                    <strong>@_selectedPalletPosition.DistancePriority</strong>
                                </div>
                                <div class="position-metric">
                                    <span>Pallets</span>
                                    <strong>@_selectedPalletPosition.MaxPallets</strong>
                                </div>
                            </div>

                            <section class="position-section">
                                <div class="position-section-header">
                                    <div>
                                        <div class="eyebrow">SKU Stock</div>
                                        <h3>Placed SKUs</h3>
                                    </div>
                                    <span class="status-pill info">@_selectedPalletPosition.Stock.Count item(s)</span>
                                </div>

                                @if (_selectedPalletPosition.Stock.Count == 0)
                                {
                                    <div class="empty-inline">No SKU stock placed in this pallet position.</div>
                                }
                                else
                                {
                                    <div class="sku-stock-list">
                                        @foreach (var stock in _selectedPalletPosition.Stock)
                                        {
                                            <article class="sku-stock-card">
                                                <div class="sku-stock-card-header">
                                                    <span class="sku-code-chip">@stock.MaterialNumber</span>
                                                    <span class="status-pill @SubtypeClass(stock.StockSubtypeCode)">@stock.StockSubtypeName</span>
                                                </div>
                                                <h4>@stock.MaterialDescription</h4>
                                                <div class="sku-stock-meta">
                                                    <div>
                                                        <span>Design Type</span>
                                                        <strong>@stock.DesignType</strong>
                                                    </div>
                                                    <div>
                                                        <span>PKM</span>
                                                        <strong>@stock.MfgMonthLabel</strong>
                                                    </div>
                                                    <div>
                                                        <span>Boxes</span>
                                                        <strong>@stock.QuantityBoxes.ToString("0.###")</strong>
                                                    </div>
                                                </div>
                                            </article>
                                        }
                                    </div>
                                }
                            </section>

                            <section class="position-section position-label-section">
                                <div>
                                    <div class="eyebrow">Physical Label</div>
                                    <div class="position-label-value">@(!string.IsNullOrWhiteSpace(_selectedPalletPosition.FlatLabel) ? _selectedPalletPosition.FlatLabel : "Not assigned")</div>
                                </div>
                            </section>
                        </div>
                    }
                </div>

                <div class="slide-over-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClosePalletDetails">Close</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<LineModel> _lines = new() { new LineModel() };
    private IReadOnlyList<MaterialDto> _materials = Array.Empty<MaterialDto>();
    private int? _activeMaterialLineIndex;
    private bool _submitting;
    private string? _error;
