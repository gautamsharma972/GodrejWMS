@page "/Error"
@using System.Diagnostics
@layout GodrejWMS.Web.Components.Layout.AuthLayout

<PageTitle>Something went wrong - Godrej WMS</PageTitle>

<div class="status-page">
    <div class="status-card">
        <span class="status-icon status-icon-danger">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        </span>
        <div class="eyebrow">Unexpected error</div>
        <h1>Something went wrong on our end</h1>
        <p>
            Your request couldn't be completed. Try again, and if it keeps happening, share the
            request ID below with support.
        </p>
        @if (ShowRequestId)
        {
            <p class="status-redirect-note">Request ID: <code>@RequestId</code></p>
        }
        <div class="status-actions">
            <a class="btn btn-primary" href="/">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                Back to Home
            </a>
            <a class="btn btn-outline-secondary" href="/Account/Login">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                Sign in again
            </a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
