@using GodrejWMS.Application.Features.Materials.Dtos

<div class="input-group search-control searchable-material-select" @onfocusout="OnBlur">
    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
    <input class="form-control" value="@_searchText" @oninput="OnInputAsync" @onfocus="OnFocus"
           placeholder="@Placeholder" autocomplete="off" aria-label="Search and select material" />
    @if (Value != 0)
    {
        <span class="input-group-text selected-material-check"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
    }
    @if (_showSuggestions)
    {
        <div class="location-suggestions">
            @if (FilteredOptions.Count == 0)
            {
                <div class="searchable-material-empty">No matching active material.</div>
            }
            else
            {
                @foreach (var option in FilteredOptions)
                {
                    <button type="button" class="location-suggestion-item @(option.Id == Value ? "selected" : null)"
                            @onmousedown="() => SelectAsync(option)" @onmousedown:preventDefault="true">
                        <span class="record-code">@option.MaterialNumber</span>
                        <span class="location-suggestion-meta">@option.Description</span>
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MaterialDto> Options { get; set; } = [];
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search material code or description";

    private string _searchText = string.Empty;
    private bool _showSuggestions;
    private int _lastValue = -1;

    private List<MaterialDto> FilteredOptions =>
        (string.IsNullOrWhiteSpace(_searchText)
            ? Options
            : Options.Where(x =>
                x.MaterialNumber.ToString().Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
                x.Description.Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase)).ToList())
        .Take(100)
        .ToList();

    protected override void OnParametersSet()
    {
        if (Value == _lastValue) return;
        _lastValue = Value;
        var selected = Options.FirstOrDefault(x => x.Id == Value);
        _searchText = selected is null ? string.Empty : $"{selected.MaterialNumber} — {selected.Description}";
    }

    private async Task OnInputAsync(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        _showSuggestions = true;
        if (Value != 0)
        {
            Value = 0;
            _lastValue = 0;
            await ValueChanged.InvokeAsync(0);
        }
    }

    private void OnFocus() => _showSuggestions = true;

    private async Task SelectAsync(MaterialDto option)
    {
        Value = option.Id;
        _lastValue = option.Id;
        _searchText = $"{option.MaterialNumber} — {option.Description}";
        _showSuggestions = false;
        await ValueChanged.InvokeAsync(option.Id);
    }

    private async Task OnBlur()
    {
        await Task.Delay(120);
        _showSuggestions = false;
        StateHasChanged();
    }
}
