<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for the Godrej WMS web application (Blazor UI), framework-dependent for Linux x64.
  "Framework-dependent" means the target machine needs the .NET 10 ASP.NET Core runtime installed;
  this profile only fixes the target OS/architecture (linux-x64) so the output includes a native
  apphost (./GodrejWMS.Web) and any linux-x64-specific native assets - it does not bundle the .NET
  runtime itself (that's what "self-contained" would do).
  Output: <repo>/publish/ui-linux-x64   (emptied before each publish, so no stale files survive a re-publish)
  Use:    dotnet publish src/GodrejWMS.Web -p:PublishProfile=UILinux     (or scripts/publish.sh ui-linux)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\ui-linux-x64\</PublishDir>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <!-- dotnet publish only overwrites files; clear the folder first so removed/renamed files don't linger. -->
  <Target Name="ClearUiLinuxPublishDir" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>
</Project>
