@page "/reports/reservation-lookup"
@attribute [Authorize(Policy = "Permission:" + GodrejWMS.Application.Common.Permissions.PermissionKeys.Menu.ViewReports)]
@using GodrejWMS.Application.Common
@using GodrejWMS.Application.Features.Reports.Queries
@using GodrejWMS.Application.Features.AopDescriptionLocationPreferences.Dtos
@using GodrejWMS.Application.Features.AopDescriptionLocationPreferences.Queries
@using GodrejWMS.Application.Features.Materials.Dtos
@using GodrejWMS.Application.Features.Materials.Queries
@inject IMediator Mediator

<PageTitle>Reservation Lookup - Godrej WMS</PageTitle>

<div class="page-shell report-page reservation-lookup-page">
    <div class="page-header">
        <div>
            <div class="eyebrow">Reports</div>
            <h1>Reservation Lookup</h1>
            <p class="page-kicker">Check whether a material or location is already reserved for an inward GRN or suggested for a pullout pick.</p>
        </div>
    </div>

    <div class="panel reservation-lookup-panel">
        <div class="reservation-search-heading">
            <div>
                <h2>Find reservations</h2>
                <p>Use any one or a combination of the filters below.</p>
            </div>
            <i class="bi bi-search" aria-hidden="true"></i>
        </div>
        <form class="toolbar-panel panel-toolbar reservation-filter-panel" @onsubmit="SearchAsync">
            <div class="toolbar-group">
                <div class="reservation-location-select reservation-filter-field">
                    <span class="reservation-filter-label">Material</span>
                    <SearchableMaterialSelect Options="_materialOptions" @bind-Value="_materialId" Placeholder="Material code" />
                </div>
                <div class="reservation-location-select reservation-filter-field">
                    <span class="reservation-filter-label">Location</span>
                    <SearchableLocationSelect Options="_locationOptions" @bind-Value="_locationId" Placeholder="Location e.g. A-25-01" AriaLabel="Search and select location" />
                </div>
                <div class="reservation-location-select reservation-filter-field">
                    <span class="reservation-filter-label">GRN reference</span>
                    <SearchableReferenceSelect Options="_grnOptions" @bind-Value="_grnReference" Placeholder="GRN Reference No." AriaLabel="Search GRN reference number" />
                </div>
                <div class="reservation-location-select reservation-filter-field">
                    <span class="reservation-filter-label">Pick reference</span>
                    <SearchableReferenceSelect Options="_pickOptions" @bind-Value="_pickReference" Placeholder="Pick Reference No." AriaLabel="Search pick reference number" />
                </div>
                <div class="form-check reservation-confirmed-toggle">
                    <input class="form-check-input" type="checkbox" id="incConfirmed" @bind="_includeConfirmed" />
                    <label class="form-check-label" for="incConfirmed">Include confirmed</label>
                </div>
                <button type="submit" class="btn btn-primary" disabled="@_loading">
                    <i class="bi bi-search" aria-hidden="true"></i> Search
                </button>
            </div>
        </form>

        @if (_error is not null)
        {
            <div class="feedback-bar warning">@_error</div>
        }

        @if (_loading)
        {
            <div class="loading-panel">
                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                Searching...
            </div>
        }
        else if (_result is null)
        {
            <div class="empty-state">Enter a material code, a location, a GRN or a Pick reference and press Search.</div>
        }
        else
        {
            <div class="reservation-result-summary">
                <div class="reservation-summary-item outbound">
                    <span class="reservation-summary-icon"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></span>
                    <span><strong>@_result.Outbound.Count</strong> pick row(s)</span>
                    <b>@_result.Outbound.Sum(r => r.QuantityBoxes).ToString("0.###") boxes</b>
                </div>
                <div class="reservation-summary-item inbound">
                    <span class="reservation-summary-icon"><i class="bi bi-box-arrow-in-down" aria-hidden="true"></i></span>
                    <span><strong>@_result.Inbound.Count</strong> GRN row(s)</span>
                    <b>@_result.Inbound.Sum(r => r.QuantityBoxes).ToString("0.###") boxes</b>
                </div>
            </div>
            @if (_result.Truncated)
            {
                <div class="feedback-bar warning">Showing the first @GetReservationLookupHandler.MaxRowsPerSide rows per side. Narrow the search to see the rest.</div>
            }

            <section class="reservation-result-section">
                <div class="reservation-section-heading">
                    <div><span class="reservation-section-icon outbound"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></span><div><h2>Pullout picks</h2><p>Matched by Pick Reference Number</p></div></div>
                    <span class="sync-chip">@_result.Outbound.Count row(s)</span>
                </div>
                @if (_result.Outbound.Count == 0)
                {
                    <div class="empty-state">No pullout pick found.</div>
                }
                else
                {
                    <div class="table-responsive reservation-table-wrap">
                    <table class="table table-sm align-middle reservation-table">
                        <thead>
                            <tr><th>Pick Reference No.</th><th>Indent No.</th><th>Destination</th><th>Vehicle No.</th><th>Material</th><th>Location</th><th>PKM</th><th class="text-end">Boxes</th><th>Status</th><th>Created</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _result.Outbound)
                            {
                                <tr>
                                    <td><a class="record-code reservation-reference" href="@LocalReturnUrl.Append($"pullout/{r.TransactionId}", ReturnUrl)">@r.PickReference</a></td>
                                    <td>@(r.IndentNumber ?? "-")</td>
                                    <td>@(r.Destination ?? "-")</td>
                                    <td>@(r.VehicleNumber ?? "-")</td>
                                    <td title="@r.MaterialDescription"><span class="record-code">@r.MaterialCode</span></td>
                                    <td><span class="location-badge"><i class="bi bi-geo-alt" aria-hidden="true"></i>@r.LocationCode</span></td>
                                    <td><span class="status-pill neutral">@r.MfgMonth</span></td>
                                    <td class="text-end">@r.QuantityBoxes.ToString("0.###")</td>
                                    <td><span class="status-pill @(r.IsConfirmed ? "success" : "warning")">@(r.IsConfirmed ? "Confirmed" : "Pending")</span></td>
                                    <td>@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </section>

            <section class="reservation-result-section">
                <div class="reservation-section-heading">
                    <div><span class="reservation-section-icon inbound"><i class="bi bi-box-arrow-in-down" aria-hidden="true"></i></span><div><h2>Inward put-aways</h2><p>Matched by GRN Reference Number</p></div></div>
                    <span class="sync-chip">@_result.Inbound.Count row(s)</span>
                </div>
                @if (_result.Inbound.Count == 0)
                {
                    <div class="empty-state">No inward reservation found.</div>
                }
                else
                {
                    <div class="table-responsive reservation-table-wrap">
                    <table class="table table-sm align-middle reservation-table">
                        <thead>
                            <tr><th>GRN Reference No.</th><th>LR No.</th><th>Vehicle No.</th><th>Material</th><th>Location</th><th>PKM</th><th class="text-end">Boxes</th><th>Status</th><th>Created</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _result.Inbound)
                            {
                                <tr>
                                    <td><a class="record-code reservation-reference" href="@LocalReturnUrl.Append($"inward/{r.TransactionId}", ReturnUrl)">@r.GrnNumber</a></td>
                                    <td>@(r.LrNumber ?? "-")</td>
                                    <td>@(r.VehicleNumber ?? "-")</td>
                                    <td title="@r.MaterialDescription"><span class="record-code">@r.MaterialCode</span></td>
                                    <td><span class="location-badge"><i class="bi bi-geo-alt" aria-hidden="true"></i>@r.LocationCode</span></td>
                                    <td><span class="status-pill neutral">@(r.MfgMonth?.ToString() ?? "No PKM")</span></td>
                                    <td class="text-end">@r.QuantityBoxes.ToString("0.###")</td>
                                    <td><span class="status-pill @(r.IsConfirmed ? "success" : "info")">@(r.IsConfirmed ? "Confirmed" : "Reserved")</span></td>
                                    <td>@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    private int _materialId;
    private IReadOnlyList<MaterialDto> _materialOptions = [];
    private int _locationId;
    private IReadOnlyList<AopLocationOptionDto> _locationOptions = [];
    private string _location => _locationOptions.FirstOrDefault(o => o.Id == _locationId)?.LocationCode ?? string.Empty;
    private string _grnReference = string.Empty;
    private string _pickReference = string.Empty;
    private IReadOnlyList<SearchableReferenceSelect.ReferenceOption> _grnOptions = [];
    private IReadOnlyList<SearchableReferenceSelect.ReferenceOption> _pickOptions = [];
    private bool _includeConfirmed;
    private bool _loading;
    private string? _error;
    private ReservationLookupResult? _result;

    private const string ReturnUrl = "/reports/reservation-lookup";

    protected override async Task OnInitializedAsync()
    {
        _materialOptions = (await Mediator.Send(new GetMaterialsQuery(IsActive: true, PageSize: 5000))).Items;
        _locationOptions = await Mediator.Send(new GetAopLocationOptionsQuery());
        var refs = await Mediator.Send(new GetReservationReferenceOptionsQuery());
        _grnOptions = refs.Grns.Select(x => new SearchableReferenceSelect.ReferenceOption(x.Reference, x.Hint)).ToList();
        _pickOptions = refs.Picks.Select(x => new SearchableReferenceSelect.ReferenceOption(x.Reference, x.Hint)).ToList();
    }

    private async Task SearchAsync()
    {
        _error = null;
        long? material = _materialOptions.FirstOrDefault(o => o.Id == _materialId)?.MaterialNumber;

        if (material is null && string.IsNullOrWhiteSpace(_location) && string.IsNullOrWhiteSpace(_grnReference) && string.IsNullOrWhiteSpace(_pickReference))
        {
            _error = "Enter at least a material code, a location, a GRN or a Pick reference.";
            return;
        }

        _loading = true;
        try
        {
            _result = await Mediator.Send(new GetReservationLookupQuery(material, _location, _grnReference, _pickReference, _includeConfirmed));
        }
        finally
        {
            _loading = false;
        }
    }
}
