    private async Task SubmitAsync()
    {
        _error = null;
        _result = null;

        if (_warehouseId is null)
        {
            _error = "Select a warehouse before submitting.";
            return;
        }

        var validLineIndexes = ValidateManualLines();
        if (_lineFieldErrors.Count > 0)
        {
            return;
        }

        var validLines = validLineIndexes.Select(index => _lines[index]).ToList();

        _submitting = true;
        try
        {
            var command = new SubmitInwardWithoutPkmCommand(
                validLines.Select(l => new SubmitInwardWithoutPkmLine(l.MaterialCode, l.QuantityBoxes)).ToList(),
                _warehouseId.Value);

            _result = await Mediator.Send(command);
            _statusFilter = string.Empty;
            _isResultModalOpen = true;
            _lines = new List<LineModel> { new() };
        }
        catch (ValidationException ex)
        {
            Logger.LogInformation(ex, "Inward (no PKM) form validation failed");
            SetLineFieldErrors(ex.Errors, validLineIndexes);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Inward (no PKM) submission failed");
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private IReadOnlyList<int> ValidateManualLines()
    {
        _lineFieldErrors.Clear();

        var enteredLineIndexes = Enumerable.Range(0, _lines.Count)
            .Where(index => !string.IsNullOrWhiteSpace(_lines[index].MaterialCodeText) || _lines[index].QuantityBoxes != 0)
            .ToList();

        if (enteredLineIndexes.Count == 0)
        {
            AddLineFieldError(0, nameof(LineModel.MaterialCodeText), "Select a material.");
            AddLineFieldError(0, nameof(LineModel.QuantityBoxes), "Quantity is required.");
            return enteredLineIndexes;
        }

        foreach (var index in enteredLineIndexes)
        {
            var line = _lines[index];
            if (line.MaterialCode <= 0)
            {
                AddLineFieldError(index, nameof(LineModel.MaterialCodeText), "Select a valid material.");
            }

            if (line.QuantityBoxes <= 0)
            {
                AddLineFieldError(index, nameof(LineModel.QuantityBoxes), "Quantity must be greater than zero.");
            }
            else if (!decimal.IsInteger(line.QuantityBoxes))
            {
                AddLineFieldError(index, nameof(LineModel.QuantityBoxes), "Quantity must be a whole number (no decimals).");
            }
        }

        return enteredLineIndexes;
    }

    private void SetLineFieldErrors(IDictionary<string, string[]> errors, IReadOnlyList<int> submittedLineIndexes)
    {
        _lineFieldErrors.Clear();

        foreach (var (property, messages) in errors)
        {
            if (!TryMapLineProperty(property, submittedLineIndexes, out var lineIndex, out var field))
            {
                continue;
            }

            AddLineFieldError(lineIndex, field, string.Join(" ", messages));
        }
    }

    private static bool TryMapLineProperty(
        string property,
        IReadOnlyList<int> submittedLineIndexes,
        out int lineIndex,
        out string field)
    {
        lineIndex = -1;
        field = string.Empty;

        const string prefix = "Lines[";
        if (!property.StartsWith(prefix, StringComparison.Ordinal))
        {
            return false;
        }

        var closingBracket = property.IndexOf(']', prefix.Length);
        if (closingBracket < 0
            || !int.TryParse(property[prefix.Length..closingBracket], out var submittedIndex)
            || submittedIndex < 0
            || submittedIndex >= submittedLineIndexes.Count)
        {
            return false;
        }

        var propertyName = property[(closingBracket + 1)..].TrimStart('.');
        field = propertyName switch
        {
            nameof(SubmitInwardWithoutPkmLine.MaterialCode) => nameof(LineModel.MaterialCodeText),
            nameof(SubmitInwardWithoutPkmLine.QuantityBoxes) => nameof(LineModel.QuantityBoxes),
            _ => string.Empty
        };

        lineIndex = submittedLineIndexes[submittedIndex];
        return field.Length > 0;
    }

    private static string LineFieldKey(int index, string field) => $"{index}:{field}";

    private void AddLineFieldError(int index, string field, string message) =>
        _lineFieldErrors[LineFieldKey(index, field)] = message;

    private bool HasLineFieldError(int index, string field) =>
        _lineFieldErrors.ContainsKey(LineFieldKey(index, field));

    private string LineFieldClass(int index, string field, string baseClass) =>
        HasLineFieldError(index, field) ? $"{baseClass} is-invalid" : baseClass;

    private RenderFragment LineFieldError(int index, string field) => builder =>
    {
        if (!_lineFieldErrors.TryGetValue(LineFieldKey(index, field), out var message))
        {
            return;
        }

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "invalid-feedback d-block");
        builder.AddAttribute(2, "role", "alert");
        builder.AddContent(3, message);
        builder.CloseElement();
    };

    private void ClearLineFieldError(int index, string field) =>
        _lineFieldErrors.Remove(LineFieldKey(index, field));

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        _result = null;
        _workbookOutcomes = null;

        if (_warehouseId is null)
        {
            _error = "Select a warehouse before uploading.";
            return;
        }

        _submitting = true;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            memory.Position = 0;

            _workbookOutcomes = await Mediator.Send(new ImportInwardWorkbookWithoutPkmCommand(memory, _warehouseId.Value));
            _statusFilter = string.Empty;
            _isWorkbookResultModalOpen = true;
        }
        catch (ValidationException ex)
        {
            Logger.LogInformation(ex, "Inward (no PKM) import validation failed");
            var messages = ex.Errors.Values
                .SelectMany(values => values)
                .Where(message => !string.IsNullOrWhiteSpace(message))
                .Distinct(StringComparer.Ordinal)
                .ToArray();
            _error = messages.Length > 0 ? string.Join(" ", messages) : ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Inward (no PKM) workbook import failed");
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

