    private static decimal OccupancyPercent(PalletPositionDto position) =>
        position.CapacityBoxes is not { } capacity || capacity <= 0 ? 0 : Math.Clamp(position.OccupiedBoxes / capacity * 100, 0, 100);

    private class LineModel
    {
        public string MaterialCodeText { get; set; } = string.Empty;
        public decimal QuantityBoxes { get; set; }

        public long MaterialCode => long.TryParse(MaterialCodeText, out var value) ? value : 0;
    }

    private sealed record AllocationResultRow(InwardLineResultDto Line, InwardAllocationLineDto? Allocation)
    {
        public decimal AllocatedQuantityBoxes => Allocation?.QuantityBoxes ?? 0;
    }
