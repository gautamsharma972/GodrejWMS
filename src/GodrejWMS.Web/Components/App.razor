<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Versioned(Assets["lib/bootstrap/dist/css/bootstrap.min.css"])" />
    <link rel="stylesheet" href="@Versioned(Assets["lib/bootstrap-icons/bootstrap-icons.min.css"])" />
    <link rel="stylesheet" href="@Versioned(Assets["app.css"])" />
    <link rel="stylesheet" href="@Versioned("GodrejWMS.Web.styles.css")" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Versioned(Assets["_framework/blazor.web.js"])"></script>
    <script src="@Versioned(Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"])"></script>
    <script src="@Versioned(Assets["Components/Account/Shared/PasskeySubmit.razor.js"])" type="module"></script>
    <script src="@Versioned(Assets["js/app.js"])"></script>
    <script src="@Versioned(Assets["js/tour.js"])"></script>
</body>

</html>

@code {
    private const string StaticAssetRevision = "20260926-1";

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private static string Versioned(string assetUrl) => $"{assetUrl}?v={StaticAssetRevision}";

    private IComponentRenderMode? PageRenderMode =>
        HttpContext?.Request.Path.StartsWithSegments("/Account") == true
            ? null
            : InteractiveServer;
}
