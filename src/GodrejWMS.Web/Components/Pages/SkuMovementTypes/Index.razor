@page "/sku-movement-types"
@attribute [Authorize]
@using GodrejWMS.Application.Features.SkuMovementTypes.Commands
@using GodrejWMS.Application.Features.SkuMovementTypes.Dtos
@using GodrejWMS.Application.Features.SkuMovementTypes.Queries
@inject IMediator Mediator
@inject ILogger<Index> Logger

<PageTitle>SKU Movement Types - Godrej WMS</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <div class="eyebrow">Master Data</div>
            <h1>SKU Movement Types</h1>
            <p class="page-kicker">Manage the SKU velocity classes (Fast-moving/Slow-moving and any you add) - display name, description, sort order, and active status.</p>
        </div>
        <div class="header-actions">
            <AuthorizeView Roles="Admin,Supervisor" Context="createContext">
                <button class="btn btn-outline-primary" @onclick="ShowCreateForm">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    New Movement Type
                </button>
            </AuthorizeView>
            <AuthorizeView Roles="Admin,Supervisor" Context="editContext">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-check2" aria-hidden="true"></i>
                    }
                    Save Movement Types
                </button>
            </AuthorizeView>
        </div>
    </div>

    @if (_saveError is not null)
    {
        <div class="alert alert-danger mb-0">@_saveError</div>
    }
    @if (_savedMessage is not null)
    {
        <div class="alert alert-success mb-0">@_savedMessage</div>
    }

    @if (_showCreateForm)
    {
        <div class="slide-over-backdrop" role="presentation" @onclick="CloseCreateForm">
            <section class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="movement-type-create-title" @onclick:stopPropagation="true">
                <div class="slide-over-header">
                    <div>
                        <div class="eyebrow">New code</div>
                        <h2 class="slide-over-title" id="movement-type-create-title">Create SKU Movement Type</h2>
                        <p class="slide-over-subtitle">SKU movement type codes are referenced from the Material Master.</p>
                    </div>
                    <button type="button" class="slide-over-close" title="Close" aria-label="Close create form" @onclick="CloseCreateForm">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <EditForm Model="_createForm" FormName="movement-type-create-form" OnValidSubmit="CreateAsync" class="slide-over-form">
                    <div class="slide-over-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Code</label>
                                <InputText class="form-control" @bind-Value="_createForm.Code" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Display Name</label>
                                <InputText class="form-control" @bind-Value="_createForm.DisplayName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Sort Order</label>
                                <InputNumber class="form-control" @bind-Value="_createForm.SortOrder" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <InputText class="form-control" @bind-Value="_createForm.Description" />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_createError))
                        {
                            <div class="alert alert-danger mt-3 mb-0">@_createError</div>
                        }
                    </div>
                    <div class="slide-over-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateForm">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2" aria-hidden="true"></i>
                            Create Movement Type
                        </button>
                    </div>
                </EditForm>
            </section>
        </div>
    }

    @if (_deleteTarget is not null)
    {
        <div class="slide-over-backdrop" role="presentation" @onclick="CancelDelete">
            <section class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="movement-type-delete-title" @onclick:stopPropagation="true">
                <div class="slide-over-header">
                    <div>
                        <div class="eyebrow">Delete movement type</div>
                        <h2 class="slide-over-title" id="movement-type-delete-title">Delete "@_deleteTarget.DisplayName"?</h2>
                        <p class="slide-over-subtitle">This cannot be undone. If any material still uses this movement type, the delete will be blocked below.</p>
                    </div>
                    <button type="button" class="slide-over-close" title="Close" aria-label="Cancel delete" @onclick="CancelDelete">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="slide-over-body">
                    @if (_deleteError is not null)
                    {
                        <div class="alert alert-danger mb-0">@_deleteError</div>
                    }
                </div>
                <div class="slide-over-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_deleting">
                        @if (_deleting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        }
                        Delete
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_rows is null)
    {
        <div class="loading-panel">
            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
            Loading SKU movement types...
        </div>
    }
    else
    {
        <div class="table-responsive panel-table">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Display Name</th>
                        <th>Description</th>
                        <th class="text-end">Sort Order</th>
                        <th>Active</th>
                        <th class="table-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td><span class="record-code">@row.Code</span></td>
                            <td style="max-width: 220px">
                                <AuthorizeView Roles="Admin,Supervisor" Context="nameEditContext">
                                    <Authorized>
                                        <input class="form-control" value="@row.DisplayName"
                                               @onchange="e => OnDisplayNameChanged(row.Id, e)" />
                                    </Authorized>
                                    <NotAuthorized>
                                        @row.DisplayName
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                            <td>
                                <AuthorizeView Roles="Admin,Supervisor" Context="descEditContext">
                                    <Authorized>
                                        <input class="form-control" value="@row.Description"
                                               @onchange="e => OnDescriptionChanged(row.Id, e)" />
                                    </Authorized>
                                    <NotAuthorized>
                                        @(row.Description ?? "-")
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                            <td class="text-end" style="max-width: 120px">
                                <AuthorizeView Roles="Admin,Supervisor" Context="sortEditContext">
                                    <Authorized>
                                        <input type="number" min="0" class="form-control" value="@row.SortOrder"
                                               @onchange="e => OnSortOrderChanged(row.Id, e)" />
                                    </Authorized>
                                    <NotAuthorized>
                                        @row.SortOrder
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                            <td>
                                <AuthorizeView Roles="Admin,Supervisor" Context="activeEditContext">
                                    <Authorized>
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" checked="@row.IsActive"
                                                   @onchange="e => OnActiveChanged(row.Id, e)" />
                                        </div>
                                    </Authorized>
                                    <NotAuthorized>
                                        <span class="status-pill @(row.IsActive ? "success" : "inactive")">@(row.IsActive ? "Active" : "Inactive")</span>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                            <td class="table-actions">
                                <AuthorizeView Roles="Admin,Supervisor" Context="rowDeleteContext">
                                    <button class="btn btn-sm btn-outline-danger" title="@($"Delete {row.DisplayName}")" aria-label="@($"Delete {row.DisplayName}")" @onclick="() => ShowDeleteConfirm(row)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<SkuMovementTypeDto>? _rows;
    private bool _saving;
    private string? _saveError;
    private string? _savedMessage;

    private bool _showCreateForm;
    private CreateFormModel _createForm = new();
    private string? _createError;

    private SkuMovementTypeDto? _deleteTarget;
    private string? _deleteError;
    private bool _deleting;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Mediator.Send(new GetSkuMovementTypesQuery());
        _rows = result.OrderBy(r => r.SortOrder).ToList();
    }

    private void OnDisplayNameChanged(int id, ChangeEventArgs e) => Update(id, r => r with { DisplayName = e.Value?.ToString() ?? r.DisplayName });

    private void OnDescriptionChanged(int id, ChangeEventArgs e) => Update(id, r => r with { Description = e.Value?.ToString() });

    private void OnSortOrderChanged(int id, ChangeEventArgs e)
    {
        if (e.Value is string value && int.TryParse(value, out var sortOrder))
        {
            Update(id, r => r with { SortOrder = sortOrder });
        }
    }

    private void OnActiveChanged(int id, ChangeEventArgs e)
    {
        var isActive = e.Value is bool b && b;
        Update(id, r => r with { IsActive = isActive });
    }

    private void Update(int id, Func<SkuMovementTypeDto, SkuMovementTypeDto> apply)
    {
        if (_rows is null)
        {
            return;
        }

        var index = _rows.FindIndex(r => r.Id == id);
        if (index >= 0)
        {
            _rows[index] = apply(_rows[index]);
        }
    }

    private async Task SaveAsync()
    {
        if (_rows is null)
        {
            return;
        }

        _saving = true;
        _saveError = null;
        _savedMessage = null;
        try
        {
            var assignments = _rows
                .Select(r => new SkuMovementTypeAssignment(r.Id, r.DisplayName, r.Description, r.SortOrder, r.IsActive))
                .ToList();
            await Mediator.Send(new UpdateSkuMovementTypesCommand(assignments));
            _savedMessage = "SKU movement types saved.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save SKU movement types");
            _saveError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void ShowCreateForm()
    {
        _createError = null;
        _createForm = new CreateFormModel();
        _showCreateForm = true;
    }

    private void CloseCreateForm()
    {
        _showCreateForm = false;
        _createError = null;
    }

    private async Task CreateAsync()
    {
        try
        {
            await Mediator.Send(new CreateSkuMovementTypeCommand(_createForm.Code, _createForm.DisplayName, _createForm.Description, _createForm.SortOrder));
            _showCreateForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to create SKU movement type");
            _createError = ex.Message;
        }
    }

    private void ShowDeleteConfirm(SkuMovementTypeDto row)
    {
        _deleteTarget = row;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _deleteTarget = null;
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null)
        {
            return;
        }

        _deleting = true;
        _deleteError = null;
        try
        {
            await Mediator.Send(new DeleteSkuMovementTypeCommand(_deleteTarget.Id));
            _deleteTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to delete SKU movement type");
            _deleteError = ex.Message;
        }
        finally
        {
            _deleting = false;
        }
    }

    private class CreateFormModel
    {
        public string Code { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int SortOrder { get; set; }
    }
}

