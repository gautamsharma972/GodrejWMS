    private IEnumerable<InwardLineResultDto> DisplayResultLines
    {
        get
        {
            var query = (_result?.Lines ?? Array.Empty<InwardLineResultDto>()).AsEnumerable();

            if (Enum.TryParse<AllocationStatus>(_statusFilter, out var status))
            {
                query = query.Where(l => l.Status == status);
            }

            return query;
        }
    }

    private IEnumerable<AllocationResultRow> DisplayResultAllocationRows
    {
        get
        {
            var rows = DisplayResultLines.SelectMany(line =>
                line.AllocatedTo.Count == 0
                    ? [new AllocationResultRow(line, null)]
                    : line.AllocatedTo.Select(allocation => new AllocationResultRow(line, allocation)));

            return (_sortBy, _sortDescending) switch
            {
                ("requested", false) => rows.OrderBy(r => r.Line.RequestedQuantityBoxes),
                ("requested", true) => rows.OrderByDescending(r => r.Line.RequestedQuantityBoxes),
                ("allocated", false) => rows.OrderBy(r => r.AllocatedQuantityBoxes),
                ("allocated", true) => rows.OrderByDescending(r => r.AllocatedQuantityBoxes),
                ("status", false) => rows.OrderBy(r => r.Line.Status),
                ("status", true) => rows.OrderByDescending(r => r.Line.Status),
                ("pallet", false) => rows.OrderBy(r => r.Allocation?.LocationCode ?? string.Empty),
                ("pallet", true) => rows.OrderByDescending(r => r.Allocation?.LocationCode ?? string.Empty),
                (_, true) => rows.OrderByDescending(r => r.Line.MaterialNumber),
                _ => rows.OrderBy(r => r.Line.MaterialNumber)
            };
        }
    }

    private void SortBy(string column)
    {
        if (_sortBy == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortBy = column;
            _sortDescending = false;
        }
    }

    private string SortIcon(string column) =>
        _sortBy == column ? (_sortDescending ? "bi-sort-down-alt" : "bi-sort-up") : "bi-arrow-down-up";

    private async Task LoadMaterialsAsync()
    {
        var page = await Mediator.Send(new GetMaterialsQuery(IsActive: true, PageSize: 1000));
        _materials = page.Items;
    }

    private IEnumerable<MaterialDto> MaterialMatches(string search)
    {
        var term = search.Trim();
        var query = _materials.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(term))
        {
            query = query.Where(m =>
                m.MaterialNumber.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ||
                m.Description.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return query.Take(8);
    }

    private void SelectMaterial(int index, MaterialDto material)
    {
        _lines[index].MaterialCodeText = material.MaterialNumber.ToString();
        ClearLineFieldError(index, nameof(LineModel.MaterialCodeText));
        _activeMaterialLineIndex = null;
    }

    [JSInvokable]
    public void CloseMaterialDropdown()
    {
        if (_activeMaterialLineIndex is null)
        {
            return;
        }

        _activeMaterialLineIndex = null;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_outsideClickHandlerId is not null)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("godrejWms.unregisterOutsideClick", _outsideClickHandlerId);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (OperationCanceledException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        _outsideClickReference?.Dispose();
    }

