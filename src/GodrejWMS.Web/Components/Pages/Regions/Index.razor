@page "/regions"
@attribute [Authorize]
@using GodrejWMS.Application.Features.Regions.Commands
@using GodrejWMS.Application.Features.Regions.Dtos
@using GodrejWMS.Application.Features.Regions.Queries
@inject IMediator Mediator
@inject ILogger<Index> Logger

<PageTitle>Regions - Godrej WMS</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <div class="eyebrow">Organization</div>
            <h1>Regions</h1>
            <p class="page-kicker">Top level of the organizational hierarchy (Region &gt; State &gt; City &gt; Warehouse).</p>
        </div>
        <div class="header-actions">
            <AuthorizeView Roles="Superadmin" Context="createContext">
                <button class="btn btn-outline-primary" @onclick="ShowCreateForm">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    New Region
                </button>
            </AuthorizeView>
            <AuthorizeView Roles="Superadmin" Context="editContext">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-check2" aria-hidden="true"></i>
                    }
                    Save Regions
                </button>
            </AuthorizeView>
        </div>
    </div>

    @if (_saveError is not null)
    {
        <div class="alert alert-danger mb-0">@_saveError</div>
    }
    @if (_savedMessage is not null)
    {
        <div class="alert alert-success mb-0">@_savedMessage</div>
    }

    @if (_showCreateForm)
    {
        <div class="slide-over-backdrop" role="presentation" @onclick="CloseCreateForm">
            <section class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="region-create-title" @onclick:stopPropagation="true">
                <div class="slide-over-header">
                    <div>
                        <div class="eyebrow">New code</div>
                        <h2 class="slide-over-title" id="region-create-title">Create Region</h2>
                    </div>
                    <button type="button" class="slide-over-close" title="Close" aria-label="Close create form" @onclick="CloseCreateForm">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <EditForm Model="_createForm" FormName="region-create-form" OnValidSubmit="CreateAsync" class="slide-over-form">
                    <div class="slide-over-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Code</label>
                                <InputText class="form-control" @bind-Value="_createForm.Code" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="_createForm.Name" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <InputText class="form-control" @bind-Value="_createForm.Description" />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_createError))
                        {
                            <div class="alert alert-danger mt-3 mb-0">@_createError</div>
                        }
                    </div>
                    <div class="slide-over-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateForm">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2" aria-hidden="true"></i>
                            Create Region
                        </button>
                    </div>
                </EditForm>
            </section>
        </div>
    }

    @if (_deleteTarget is not null)
    {
        <div class="slide-over-backdrop" role="presentation" @onclick="CancelDelete">
            <section class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="region-delete-title" @onclick:stopPropagation="true">
                <div class="slide-over-header">
                    <div>
                        <div class="eyebrow">Delete region</div>
                        <h2 class="slide-over-title" id="region-delete-title">Delete "@_deleteTarget.Name"?</h2>
                        <p class="slide-over-subtitle">This cannot be undone. If any state still belongs to this region, the delete will be blocked below.</p>
                    </div>
                    <button type="button" class="slide-over-close" title="Close" aria-label="Cancel delete" @onclick="CancelDelete">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="slide-over-body">
                    @if (_deleteError is not null)
                    {
                        <div class="alert alert-danger mb-0">@_deleteError</div>
                    }
                </div>
                <div class="slide-over-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_deleting">
                        @if (_deleting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        }
                        Delete
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_rows is null)
    {
        <div class="loading-panel">
            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
            Loading regions...
        </div>
    }
    else
    {
        <div class="table-responsive panel-table">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Active</th>
                        <th class="table-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>
                                <AuthorizeView Roles="Superadmin" Context="codeEditContext">
                                    <Authorized>
                                        <input class="form-control" value="@row.Code" style="max-width: 140px"
                                               @onchange="e => OnCodeChanged(row.Id, e)" />
                                    </Authorized>
                                    <NotAuthorized>
                                        <span class="record-code">@row.Code</span>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                            <td style="max-width: 220px">
                                <AuthorizeView Roles="Superadmin" Context="nameEditContext">
                                    <Authorized>
                                        <input class="form-control" value="@row.Name"
                                               @onchange="e => OnNameChanged(row.Id, e)" />
                                    </Authorized>
                                    <NotAuthorized>
                                        @row.Name
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                            <td style="max-width: 260px">
                                <AuthorizeView Roles="Superadmin" Context="descEditContext">
                                    <Authorized>
                                        <input class="form-control" value="@row.Description"
                                               @onchange="e => OnDescriptionChanged(row.Id, e)" />
                                    </Authorized>
                                    <NotAuthorized>
                                        @(row.Description ?? "-")
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                            <td>
                                <AuthorizeView Roles="Superadmin" Context="activeEditContext">
                                    <Authorized>
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" checked="@row.IsActive"
                                                   @onchange="e => OnActiveChanged(row.Id, e)" />
                                        </div>
                                    </Authorized>
                                    <NotAuthorized>
                                        <span class="status-pill @(row.IsActive ? "success" : "inactive")">@(row.IsActive ? "Active" : "Inactive")</span>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                            <td class="table-actions">
                                <AuthorizeView Roles="Superadmin" Context="rowDeleteContext">
                                    <button class="btn btn-sm btn-outline-danger" title="@($"Delete {row.Name}")" aria-label="@($"Delete {row.Name}")" @onclick="() => ShowDeleteConfirm(row)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<RegionDto>? _rows;
    private bool _saving;
    private string? _saveError;
    private string? _savedMessage;

    private bool _showCreateForm;
    private CreateFormModel _createForm = new();
    private string? _createError;

    private RegionDto? _deleteTarget;
    private string? _deleteError;
    private bool _deleting;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Mediator.Send(new GetRegionsQuery());
        _rows = result.OrderBy(r => r.Name).ToList();
    }

    private void OnCodeChanged(int id, ChangeEventArgs e) => Update(id, r => r with { Code = e.Value?.ToString() ?? r.Code });
    private void OnNameChanged(int id, ChangeEventArgs e) => Update(id, r => r with { Name = e.Value?.ToString() ?? r.Name });
    private void OnDescriptionChanged(int id, ChangeEventArgs e) => Update(id, r => r with { Description = e.Value?.ToString() });

    private void OnActiveChanged(int id, ChangeEventArgs e)
    {
        var isActive = e.Value is bool b && b;
        Update(id, r => r with { IsActive = isActive });
    }

    private void Update(int id, Func<RegionDto, RegionDto> apply)
    {
        if (_rows is null) return;
        var index = _rows.FindIndex(r => r.Id == id);
        if (index >= 0) _rows[index] = apply(_rows[index]);
    }

    private async Task SaveAsync()
    {
        if (_rows is null) return;
        _saving = true;
        _saveError = null;
        _savedMessage = null;
        try
        {
            var assignments = _rows
                .Select(r => new RegionAssignment(r.Id, r.Code, r.Name, r.Description, r.IsActive))
                .ToList();
            await Mediator.Send(new UpdateRegionsCommand(assignments));
            _savedMessage = "Regions saved.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save regions");
            _saveError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void ShowCreateForm()
    {
        _createError = null;
        _createForm = new CreateFormModel();
        _showCreateForm = true;
    }

    private void CloseCreateForm()
    {
        _showCreateForm = false;
        _createError = null;
    }

    private async Task CreateAsync()
    {
        try
        {
            await Mediator.Send(new CreateRegionCommand(_createForm.Code, _createForm.Name, _createForm.Description));
            _showCreateForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to create region");
            _createError = ex.Message;
        }
    }

    private void ShowDeleteConfirm(RegionDto row)
    {
        _deleteTarget = row;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _deleteTarget = null;
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _deleting = true;
        _deleteError = null;
        try
        {
            await Mediator.Send(new DeleteRegionCommand(_deleteTarget.Id));
            _deleteTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to delete region");
            _deleteError = ex.Message;
        }
        finally
        {
            _deleting = false;
        }
    }

    private class CreateFormModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
