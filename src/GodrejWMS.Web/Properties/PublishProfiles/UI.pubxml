<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for the Godrej WMS web application (Blazor UI; it hosts the business logic in-process).
  Output: <repo>/publish/ui   (emptied before each publish, so no stale files survive a re-publish)
  Use:    dotnet publish src/GodrejWMS.Web -p:PublishProfile=UI     (or scripts/publish.sh ui)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\ui\</PublishDir>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <!-- dotnet publish only overwrites files; clear the folder first so removed/renamed files don't linger. -->
  <Target Name="ClearUiPublishDir" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>
</Project>
