@page "/reports/pending-confirmation"
@attribute [Authorize(Policy = "Permission:" + GodrejWMS.Application.Common.Permissions.PermissionKeys.Menu.ViewReports)]
@using GodrejWMS.Application.Common.Interfaces
@using GodrejWMS.Application.Features.Reports.Core
@using GodrejWMS.Application.Features.Reports.Queries
@inject IMediator Mediator

<PageTitle>Pending Confirmation - Godrej WMS</PageTitle>

<div class="page-shell report-page">
    <div class="page-header">
        <div>
            <div class="eyebrow">Reports / Exceptions</div>
            <h1>Pending Confirmation</h1>
            <p class="page-kicker">Inward and pullout orders already posted to inventory that the picker has not finished. Until then the system is ahead of the shelf (inward) or behind it (pullout). Overdue items should be chased first.</p>
        </div>
    </div>

    <section class="filter-bar" aria-label="Filters">
        <div class="filter-grid">
            <label class="filter-field">
                <span>Warehouse</span>
                <select class="form-select" @bind="_warehouseText">
                    <option value="">All assigned warehouses</option>
                    @foreach (var warehouse in _warehouses)
                    {
                        <option value="@warehouse.Id">@warehouse.Code — @warehouse.Name</option>
                    }
                </select>
            </label>
            <label class="filter-field">
                <span>Overdue after (hours)</span>
                <input class="form-control" type="number" min="1" @bind="_overdueHours" />
            </label>
            <button type="button" class="btn btn-primary filter-apply" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-funnel-fill" aria-hidden="true"></i>
                <span>Apply filters</span>
            </button>
        </div>
    </section>

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="panel">
        @if (_loading)
        {
            <div class="loading-panel"><div class="spinner-border spinner-border-sm" aria-hidden="true"></div> Loading...</div>
        }
        else if (_report is null || _report.Rows.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                <strong>Nothing is waiting for the picker</strong>
                <span>Every posted GRN and pullout has been confirmed on the floor.</span>
            </div>
        }
        else
        {
            <p class="mb-3">
                <strong>@_report.Rows.Count</strong> pending
                · <strong class="@(_report.OverdueCount > 0 ? "text-danger" : null)">@_report.OverdueCount</strong> overdue (over @_report.OverdueHours h)
                · inward not yet placed: <strong>@_report.WaitingInwardBoxes.ToString("N0")</strong> boxes
                · pullout not yet picked: <strong>@_report.WaitingPulloutBoxes.ToString("N0")</strong> boxes
            </p>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Type</th><th>Reference</th><th>Warehouse</th><th>Waiting since</th><th class="text-end">Age (h)</th>
                            <th class="text-end">Locations / picks waiting</th><th class="text-end">Boxes waiting</th><th class="text-end">PICK-RESERVED boxes</th><th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _report.Rows)
                        {
                            <tr class="@(row.IsOverdue ? "table-warning" : null)">
                                <td><span class="status-pill neutral">@row.Kind</span></td>
                                <td><a class="record-code" href="@(row.Kind == "GRN" ? $"/inward/{row.Id}" : $"/pullout/{row.Id}")">@row.ReferenceNumber</a></td>
                                <td>@row.WarehouseCode</td>
                                <td>@row.Since.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td class="text-end"><strong>@row.AgeHours.ToString("N0")</strong>@(row.IsOverdue ? " ⚠" : null)</td>
                                <td class="text-end">@row.WaitingCount</td>
                                <td class="text-end"><strong>@row.WaitingBoxes.ToString("N0")</strong></td>
                                <td class="text-end">@(row.PickReservedBoxes > 0 ? row.PickReservedBoxes.ToString("N0") : "-")</td>
                                <td>@row.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private PendingConfirmationReportDto? _report;
    private IReadOnlyList<WarehouseOption> _warehouses = [];
    private string _warehouseText = string.Empty;
    private int _overdueHours = 24;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _warehouses = await Mediator.Send(new GetAccessibleWarehousesQuery());
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            int? warehouseId = int.TryParse(_warehouseText, out var id) ? id : null;
            _report = await Mediator.Send(new GetPendingConfirmationReportQuery(warehouseId, _overdueHours));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
