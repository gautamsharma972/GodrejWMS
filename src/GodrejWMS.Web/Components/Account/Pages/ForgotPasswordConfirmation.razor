@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Password reset sent - Godrej WMS</PageTitle>

<div class="auth-page-narrow">
    <section class="auth-card text-center" role="alert">
        <div class="auth-success-icon">
            <i class="bi bi-envelope-check" aria-hidden="true"></i>
        </div>
        <div class="eyebrow">Recovery Email Sent</div>
        <h1>Please check your email</h1>
        <p class="page-kicker mx-auto">Password reset instructions have been sent when the account is eligible.</p>
        <a class="btn btn-primary" href="Account/Login">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Back to Sign In
        </a>
    </section>
</div>
