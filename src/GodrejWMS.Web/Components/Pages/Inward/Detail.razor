@page "/inward/{TransactionId:int}"
@attribute [Authorize(Policy = "Permission:" + GodrejWMS.Application.Common.Permissions.PermissionKeys.Menu.ViewInward)]
@using GodrejWMS.Application.Features.Inward.Commands
@using GodrejWMS.Application.Features.Inward.Dtos
@using GodrejWMS.Application.Features.Inward.Queries
@using GodrejWMS.Application.Features.Racks.Dtos
@using GodrejWMS.Application.Features.Racks.Queries
@using GodrejWMS.Domain.Enums
@inject IMediator Mediator
@inject ILogger<Detail> Logger
@inject IJSRuntime JsRuntime
@inject GodrejWMS.Application.Common.Interfaces.IExcelService ExcelService

<PageTitle>Inward Detail - Godrej WMS</PageTitle>

<div class="page-shell">
    @if (_loading)
    {
        <div class="loading-panel">
            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
            Loading inward transaction...
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger mb-0">@_error</div>
        <a class="btn btn-outline-secondary mt-3" href="/inward">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Back to Inward
        </a>
    }
    else if (_detail is not null)
    {
        <div class="page-header">
            <div>
                <div class="eyebrow">Goods Receipt Audit</div>
                <h1>@_detail.ReferenceNumber</h1>
                <p class="page-kicker">Created @_detail.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p>
                <span class="status-pill @(_detail.IsRejected ? "danger" : _detail.IsConfirmed ? "success" : "warning")">
                    @(_detail.IsRejected ? "Rejected" : _detail.IsConfirmed ? "Stock confirmed" : "Locations reserved")
                </span>
            </div>
            <div class="toolbar-group inward-detail-actions">
                @if (!_detail.IsConfirmed && !_detail.IsRejected)
                {
                    <div class="inward-action-cluster inward-workflow-actions">
                        <a class="btn btn-outline-primary" href="@($"/inward/{_detail.Id}/putaway")" title="Start put-away execution">
                            <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i>
                            Putaway
                        </a>
                        @if (CanRefreshPutaway)
                        {
                            <button type="button" class="btn btn-outline-primary" @onclick="RefreshPutawayAsync" disabled="@(_refreshingPutaway || _confirming)"
                                    title="Release unconfirmed reservations and allocate again using the latest Brand and location preferences">
                                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                @(_refreshingPutaway ? "Refreshing..." : "Refresh Put-away")
                            </button>
                        }
                        <button type="button" class="btn btn-primary" @onclick="ConfirmPutawayAsync" disabled="@(_confirming || _refreshingPutaway)"
                                title="Confirm all reserved put-away locations">
                            <i class="bi bi-check2-circle" aria-hidden="true"></i>
                            @(_confirming ? "Confirming..." : "Confirm")
                        </button>
                    </div>
                }

                @if (!_detail.IsRejected || CanUploadLocationChanges || CanReallocate)
                {
                    <div class="inward-action-cluster inward-allocation-actions">
                    @if (!_detail.IsRejected)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="DownloadExcelAsync"
                                title="Download this GRN's allocation as Excel@(_detail.IsConfirmed ? string.Empty : " (before confirming)")">
                            <i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i>
                            Download allocation
                        </button>
                    }
                    @if (CanUploadLocationChanges)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="OpenLocationUpload">
                            <i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i>
                            Upload changes
                        </button>
                    }
                    @if (CanReallocate)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="ReallocateAsync" disabled="@_reallocating">
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                            @(_reallocating ? "Reallocating..." : "Reallocate")
                        </button>
                    }
                    </div>
                }

                @if (CanReject)
                {
                    <button type="button" class="btn btn-outline-danger inward-reject-action" @onclick="ToggleRejectPanel">
                        <i class="bi bi-x-circle" aria-hidden="true"></i>
                        Reject GRN
                    </button>
                }
                <a class="btn btn-outline-secondary" href="/inward">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Back
                </a>
            </div>
        </div>

        @if (_detail.IsConfirmed)
        {
            <div class="putaway-info-bar transaction-status-bar confirmed" role="status" aria-live="polite">
                <div class="info-bar-icon">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                </div>
                <div class="info-bar-content">
                    <h2>Stock confirmed</h2>
                    <p>@(_confirmationMessage ?? "Dashboard and inventory views now reflect this GRN.")</p>
                </div>
                <span class="status-pill success">Inventory updated</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_reallocationMessage))
        {
            <div class="alert alert-success">@_reallocationMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_reallocationError))
        {
            <div class="alert alert-danger">@_reallocationError</div>
        }

        @if (!string.IsNullOrWhiteSpace(_refreshPutawayMessage))
        {
            <div class="feedback-bar success" role="status"><div class="feedback-bar-icon"><i class="bi bi-check2-circle"></i></div><div class="feedback-bar-content"><strong>Put-away refreshed</strong><span>@_refreshPutawayMessage</span></div></div>
        }

        @if (!string.IsNullOrWhiteSpace(_refreshPutawayError))
        {
            <div class="feedback-bar danger" role="alert"><div class="feedback-bar-icon"><i class="bi bi-exclamation-triangle"></i></div><div class="feedback-bar-content"><strong>Unable to refresh put-away</strong><span>@_refreshPutawayError</span></div></div>
        }

        @if (_detail.IsRejected)
        {
            <div class="alert alert-danger d-flex justify-content-between align-items-start">
                <div>
                    <strong>This GRN was rejected.</strong>
                    <div>Reason: @_detail.RejectionReason</div>
                </div>
                <div class="text-end text-nowrap">
                    <div>@(_detail.RejectedByUserName ?? "Unknown user")</div>
                    @if (_detail.RejectedAt.HasValue)
                    {
                        <div>@_detail.RejectedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                    }
                </div>
            </div>
        }

        @if (_showRejectPanel)
        {
            <div class="panel mb-4">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Reject this GRN</h2>
                        <p class="panel-subtitle">Releases every unconfirmed reserved location back to the pool. This can't be undone.</p>
                    </div>
                </div>
                <div class="panel-body">
                    @if (!string.IsNullOrWhiteSpace(_rejectError))
                    {
                        <div class="alert alert-danger mb-3">@_rejectError</div>
                    }
                    <label class="form-label">Reason for rejection <span class="text-danger">*</span></label>
                    <input class="form-control" placeholder="e.g. Vendor sent wrong material, refused at dock"
                           @bind="_rejectReason" @bind:event="oninput" />
                    <div class="slide-over-footer px-0">
                        <button type="button" class="btn btn-outline-secondary" @onclick="ToggleRejectPanel">Cancel</button>
                        <button type="button" class="btn btn-danger" disabled="@(_rejecting || string.IsNullOrWhiteSpace(_rejectReason))" @onclick="RejectGrnAsync">
                            @(_rejecting ? "Rejecting..." : "Confirm Rejection")
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="putaway-stepper" aria-label="Put-away progress">
            <div class="putaway-step complete">
                <span class="putaway-step-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                <div>
                    <strong>GRN received</strong>
                    <span>@_detail.Lines.Sum(l => l.RequestedQuantityBoxes).ToString("N0") boxes captured</span>
                </div>
            </div>
            <div class="putaway-step @StepClass(HasAnyAllocation())">
                <span class="putaway-step-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                <div>
                    <strong>Allocation suggested</strong>
                    <span>@_detail.Lines.Sum(l => l.AllocatedQuantityBoxes).ToString("N0") boxes planned</span>
                </div>
            </div>
            <div class="putaway-step @StepClass(HasAnyReservation())">
                <span class="putaway-step-icon"><i class="bi bi-pin-map" aria-hidden="true"></i></span>
                <div>
                    <strong>Locations reserved</strong>
                    <span>@_detail.Lines.SelectMany(l => l.Putaways).Select(p => p.LocationCode).Distinct().Count() location(s)</span>
                </div>
            </div>
            <div class="putaway-step @(_detail.IsRejected ? "rejected" : StepClass(_detail.IsConfirmed))">
                <span class="putaway-step-icon"><i class="bi @(_detail.IsRejected ? "bi-x-circle" : "bi-check2-circle")" aria-hidden="true"></i></span>
                <div>
                    <strong>@(_detail.IsRejected ? "Rejected" : "Stock confirmed")</strong>
                    <span>@(_detail.IsRejected ? "No stock was put away" : _detail.IsConfirmed ? "Dashboard and inventory updated" : "Waiting for operator confirmation")</span>
                </div>
            </div>
        </div>

        <div class="audit-metric-grid mb-4">
            <div class="audit-summary-card accent-blue">
                <div class="audit-summary-top">
                    <span class="audit-summary-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span>
                    <span class="audit-summary-status">Receipt lines</span>
                </div>
                <div class="audit-summary-value">@_detail.Lines.Count</div>
                <div class="audit-summary-label">Material rows captured</div>
                <div class="audit-summary-meta">GRN line audit</div>
            </div>
            <div class="audit-summary-card accent-indigo">
                <div class="audit-summary-top">
                    <span class="audit-summary-icon"><i class="bi bi-box-arrow-in-down" aria-hidden="true"></i></span>
                    <span class="audit-summary-status">Inbound volume</span>
                </div>
                <div class="audit-summary-value">@_detail.Lines.Sum(l => l.RequestedQuantityBoxes).ToString("N0")</div>
                <div class="audit-summary-label">Boxes received</div>
                <div class="audit-summary-meta">Awaiting put-away confirmation</div>
            </div>
            <div class="audit-summary-card accent-green">
                <div class="audit-summary-top">
                    <span class="audit-summary-icon"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i></span>
                    <span class="audit-summary-status">@CompletionRate(_detail.Lines.Sum(l => l.AllocatedQuantityBoxes), _detail.Lines.Sum(l => l.RequestedQuantityBoxes)).ToString("0")% allocated</span>
                </div>
                <div class="audit-summary-value">@_detail.Lines.Sum(l => l.AllocatedQuantityBoxes).ToString("N0")</div>
                <div class="audit-summary-label">Boxes put away</div>
                <div class="audit-progress" aria-hidden="true"><span style="@($"width: {CompletionRate(_detail.Lines.Sum(l => l.AllocatedQuantityBoxes), _detail.Lines.Sum(l => l.RequestedQuantityBoxes)):0.##}%")"></span></div>
            </div>
        </div>

        <div class="panel putaway-summary-panel mb-4">
            <div class="panel-header">
                <div>
                    <h2 class="panel-title">Putaway Summary</h2>
                    <p class="panel-subtitle">Where this GRN's stock ended up, and who confirmed it.</p>
                </div>
            </div>
            <div class="panel-body">
                <div class="putaway-summary-grid">
                    <div>
                        <span>Total Qty</span>
                        <strong>@TotalQtyBoxes.ToString("0.###")</strong>
                    </div>
                    <div>
                        <span>Putaway Qty</span>
                        <strong>@PutawayQtyBoxes.ToString("0.###")</strong>
                    </div>
                    <div>
                        <span>Pending Qty</span>
                        <strong>@PendingQtyBoxes.ToString("0.###")</strong>
                    </div>
                    <div>
                        <span>Locations Used</span>
                        <strong>@LocationsUsedCount</strong>
                    </div>
                    <div>
                        <span>Overrides</span>
                        <strong>@OverridesCount</strong>
                    </div>
                </div>
                @if (_detail.IsRejected)
                {
                    <div class="putaway-summary-completion pending">
                        <i class="bi bi-x-circle" aria-hidden="true"></i>
                        <span>Rejected - no stock was put away for this GRN.</span>
                    </div>
                }
                else if (_detail.IsConfirmed)
                {
                    <div class="putaway-summary-completion">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        <span>
                            Completed by <strong>@(CompletedByUserName ?? "unknown user")</strong>
                            @if (CompletionDate.HasValue)
                            {
                                <text> on <strong>@CompletionDate.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</strong></text>
                            }
                        </span>
                    </div>
                }
                else
                {
                    <div class="putaway-summary-completion pending">
                        <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                        <span>Not yet fully confirmed - @PendingQtyBoxes.ToString("0.###") box(es) still pending.</span>
                    </div>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <div>
                    <h2 class="panel-title">Put-away Detail</h2>
                    <p class="panel-subtitle">Locations recorded against each inward line.</p>
                </div>
                <div class="toolbar-group">
                    @if (_selectedPutawayIds.Count > 0)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="OpenBulkRackChangeAsync">
                            <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                            Change rack (@_selectedPutawayIds.Count)
                        </button>
                    }
                    <span class="status-pill info">Allocation audit</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="selection-column">
                                <input class="form-check-input" type="checkbox"
                                       aria-label="Select all unconfirmed allocations"
                                       checked="@AreAllVisiblePutawaysSelected"
                                       disabled="@(!SelectablePutawayIds.Any())"
                                       @onchange="ToggleAllVisiblePutaways" />
                            </th>
                            <th aria-sort="@SortAria("material")"><button type="button" class="sort-button" @onclick='@(() => SortBy("material"))'>Material <i class="bi @SortIcon("material")" aria-hidden="true"></i></button></th>
                            <th aria-sort="@SortAria("pkm")"><button type="button" class="sort-button" @onclick='@(() => SortBy("pkm"))'>PKM <i class="bi @SortIcon("pkm")" aria-hidden="true"></i></button></th>
                            <th class="text-end" aria-sort="@SortAria("requested")"><button type="button" class="sort-button" @onclick='@(() => SortBy("requested"))'>Requested <i class="bi @SortIcon("requested")" aria-hidden="true"></i></button></th>
                            <th class="text-end" aria-sort="@SortAria("allocated")"><button type="button" class="sort-button" @onclick='@(() => SortBy("allocated"))'>Allocated <i class="bi @SortIcon("allocated")" aria-hidden="true"></i></button></th>
                            <th aria-sort="@SortAria("status")"><button type="button" class="sort-button" @onclick='@(() => SortBy("status"))'>Status <i class="bi @SortIcon("status")" aria-hidden="true"></i></button></th>
                            <th aria-sort="@SortAria("location")"><button type="button" class="sort-button" @onclick='@(() => SortBy("location"))'>Put Away To <i class="bi @SortIcon("location")" aria-hidden="true"></i></button></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in DisplayPutawayRows)
                        {
                            <tr>
                                <td class="selection-column">
                                    @if (row.Putaway is { IsConfirmed: false, Id: > 0 })
                                    {
                                        <input class="form-check-input" type="checkbox"
                                               aria-label="Select allocation at @row.Putaway.LocationCode"
                                               checked="@_selectedPutawayIds.Contains(row.Putaway.Id)"
                                               @onchange="e => TogglePutaway(row.Putaway.Id, e)" />
                                    }
                                </td>
                                <td>
                                    <span class="record-code">@row.Line.MaterialNumber</span>
                                    <span>@row.Line.MaterialDescription</span>
                                </td>
                                <td><span class="status-pill neutral">@row.Line.MfgMonthLabel</span></td>
                                <td class="text-end">@row.Line.RequestedQuantityBoxes.ToString("N0")</td>
                                <td class="text-end fw-semibold">@row.AllocatedQuantityBoxes.ToString("N0")</td>
                                <td>
                                    <span class="status-pill @AllocationClass(row.Line.Status)">@row.Line.Status</span>
                                    @if (!string.IsNullOrWhiteSpace(row.Line.Remarks))
                                    {
                                        <span class="text-muted ms-2">@row.Line.Remarks</span>
                                    }
                                </td>
                                <td>
                                    @if (row.Putaway is null)
                                    {
                                        <span class="text-muted">No location audit captured for this older transaction.</span>
                                    }
                                    else
                                    {
                                        <div class="allocation-pill-list">
                                            <button type="button"
                                                    class="allocation-location-pill"
                                                    title="@PutawayTitle(row.Putaway)"
                                                    @onclick="() => OpenPalletDetailsAsync(row.Putaway.LocationCode)">
                                                <span>@row.Putaway.LocationCode</span>
                                                <strong>+@row.Putaway.QuantityBoxes.ToString("N0")</strong>
                                            </button>
                                            @if (!row.Putaway.IsConfirmed && row.Putaway.Id > 0)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary allocation-change-button"
                                                        title="Change put-away quantity or location"
                                                        aria-label="Change put-away quantity or location"
                                                        @onclick="() => OpenChangeLocationAsync(row.Putaway.Id, row.Putaway.LocationCode, row.Putaway.QuantityBoxes, row.Line.RequestedQuantityBoxes - row.Line.AllocatedQuantityBoxes + row.Putaway.QuantityBoxes)">
                                                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                                                    <span>Change</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (_isPalletDetailsOpen)
        {
            <div class="slide-over-backdrop" role="presentation" @onclick="ClosePalletDetails">
                <div class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="pallet-detail-title" @onclick:stopPropagation="true">
                    <div class="slide-over-header">
                        <div>
                            <div class="eyebrow">Pallet Position</div>
                            <h2 id="pallet-detail-title" class="slide-over-title">Pallet Details</h2>
                            <p class="slide-over-subtitle">@(_selectedPalletPosition?.LocationCode ?? "Loading location details")</p>
                        </div>
                        <button type="button" class="slide-over-close" aria-label="Close pallet details" @onclick="ClosePalletDetails">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="slide-over-body">
                        @if (!string.IsNullOrWhiteSpace(_palletDetailsError))
                        {
                            <div class="alert alert-danger mb-0">@_palletDetailsError</div>
                        }
                        else if (_selectedPalletPosition is null)
                        {
                            <div class="loading-panel">
                                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                                Loading pallet details...
                            </div>
                        }
                        else
                        {
                            <div class="position-detail-shell">
                                <div class="position-summary-card">
                                    <div class="position-summary-top">
                                        <div>
                                            <div class="eyebrow">Location</div>
                                            <h2>@_selectedPalletPosition.LocationCode</h2>
                                        </div>
                                        <span class="status-pill @(_selectedPalletPosition.IsActive ? "success" : "inactive")">@(_selectedPalletPosition.IsActive ? "Active" : "Inactive")</span>
                                    </div>

                                    <div class="position-tag-row">
                                        <span class="status-pill info">@_selectedPalletPosition.LocationTypeName</span>
                                        <span class="status-pill @SubtypeClass(_selectedPalletPosition.LocationSubtypeCode)">@_selectedPalletPosition.LocationSubtypeName</span>
                                        <span class="status-pill @ZoneClass(_selectedPalletPosition.ZoneTypeCode)">@_selectedPalletPosition.ZoneTypeName</span>
                                    </div>

                                    <div class="position-progress-block">
                                        <div>
                                            <span>Occupied</span>
                                            <strong>@_selectedPalletPosition.OccupiedBoxes.ToString("0.###") / @(_selectedPalletPosition.CapacityBoxes?.ToString() ?? "—") boxes</strong>
                                        </div>
                                        <span>@OccupancyPercent(_selectedPalletPosition).ToString("0.#")%</span>
                                    </div>
                                    <div class="position-progress-track">
                                        <span style="@($"width:{OccupancyPercent(_selectedPalletPosition):0.##}%")"></span>
                                    </div>
                                </div>

                                <div class="position-metric-grid">
                                    <div class="position-metric"><span>Capacity</span><strong>@(_selectedPalletPosition.CapacityBoxes?.ToString() ?? "—")</strong></div>
                                    <div class="position-metric"><span>Occupied</span><strong>@_selectedPalletPosition.OccupiedBoxes.ToString("0.###")</strong></div>
                                    <div class="position-metric success"><span>Free</span><strong>@(_selectedPalletPosition.FreeBoxes?.ToString("0.###") ?? "—")</strong></div>
                                    <div class="position-metric"><span>Priority</span><strong>@_selectedPalletPosition.DistancePriority</strong></div>
                                    <div class="position-metric"><span>Pallets</span><strong>@_selectedPalletPosition.MaxPallets</strong></div>
                                </div>

                                <section class="position-section">
                                    <div class="position-section-header">
                                        <div>
                                            <div class="eyebrow">SKU Stock</div>
                                            <h3>Placed SKUs</h3>
                                        </div>
                                        <span class="status-pill info">@_selectedPalletPosition.Stock.Count item(s)</span>
                                    </div>

                                    @if (_selectedPalletPosition.Stock.Count == 0)
                                    {
                                        <div class="empty-inline">No SKU stock placed in this pallet position.</div>
                                    }
                                    else
                                    {
                                        <div class="sku-stock-list">
                                            @foreach (var stock in _selectedPalletPosition.Stock)
                                            {
                                                <article class="sku-stock-card">
                                                    <div class="sku-stock-card-header">
                                                        <span class="sku-code-chip">@stock.MaterialNumber</span>
                                                        <span class="status-pill @SubtypeClass(stock.StockSubtypeCode)">@stock.StockSubtypeName</span>
                                                    </div>
                                                    <h4>@stock.MaterialDescription</h4>
                                                    <div class="sku-stock-meta">
                                                        <div><span>Design Type</span><strong>@stock.DesignType</strong></div>
                                                        <div><span>PKM</span><strong>@stock.MfgMonthLabel</strong></div>
                                                        <div><span>Boxes</span><strong>@stock.QuantityBoxes.ToString("0.###")</strong></div>
                                                    </div>
                                                </article>
                                            }
                                        </div>
                                    }
                                </section>

                                <section class="position-section position-label-section">
                                    <div>
                                        <div class="eyebrow">Physical Label</div>
                                        <div class="position-label-value">@(!string.IsNullOrWhiteSpace(_selectedPalletPosition.FlatLabel) ? _selectedPalletPosition.FlatLabel : "Not assigned")</div>
                                    </div>
                                </section>
                            </div>
                        }
                    </div>

                    <div class="slide-over-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClosePalletDetails">Close</button>
                    </div>
                </div>
            </div>
        }

        @if (_isChangeLocationOpen)
        {
            <div class="slide-over-backdrop" role="presentation" @onclick="CloseChangeLocation">
                <div class="slide-over-panel putaway-change-panel" role="dialog" aria-modal="true" aria-labelledby="change-location-title" @onclick:stopPropagation="true">
                    <div class="slide-over-header">
                        <div>
                            <div class="eyebrow">Put-away Reservation</div>
                            <h2 id="change-location-title" class="slide-over-title">Change Quantity or Location</h2>
                            <p class="slide-over-subtitle">Adjust the quantity or split it across available locations.</p>
                            <div class="putaway-current-summary">
                                <span><i class="bi bi-box-seam" aria-hidden="true"></i> @_changeOriginalQuantityBoxes.ToString("0.###") box(es)</span>
                                <span><i class="bi bi-geo-alt" aria-hidden="true"></i> @_changeCurrentLocationCode</span>
                            </div>
                        </div>
                        <button type="button" class="slide-over-close" aria-label="Close change location" @onclick="CloseChangeLocation">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="slide-over-body">
                        @if (!string.IsNullOrWhiteSpace(_changeError))
                        {
                            <div class="alert alert-danger mb-0">@_changeError</div>
                        }

                        <div class="putaway-reason-field">
                            <label class="form-label">Reason for override <span class="text-danger">*</span></label>
                            <input class="form-control" placeholder="e.g. Damaged pallet in original slot"
                                   @bind="_changeReason" @bind:event="oninput" />
                        </div>

                        @if (_changeOptions is null)
                        {
                            <div class="loading-panel">
                                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                                Loading available locations...
                            </div>
                        }
                        else if (_changeOptions.Count == 0)
                        {
                            <div class="empty-state">No alternate locations have enough free capacity right now.</div>
                        }
                        else
                        {
                        <div class="toolbar-panel change-location-toolbar putaway-location-toolbar">
                            <div class="toolbar-group">
                                    <div class="input-group search-control">
                                        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                                        <input class="form-control" placeholder="Search location, subtype, or zone"
                                       @bind="_changeLocationSearch" @bind:event="oninput" />
                                </div>
                                <select class="form-select change-rack-filter" aria-label="Filter alternate locations by rack" @bind="_changeRackFilter">
                                    <option value="">All racks</option>
                                    @foreach (var rackCode in ChangeRackOptions)
                                    {
                                        <option value="@rackCode">Rack @rackCode@(rackCode.Equals(RackCodeOf(_changeCurrentLocationCode), StringComparison.OrdinalIgnoreCase) ? " (current)" : string.Empty)</option>
                                    }
                                </select>
                            </div>
                                <span class="sync-chip">@DisplayChangeOptions.Count().ToString("N0") location(s)</span>
                            </div>

                            <div class="table-responsive putaway-location-list">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th class="selection-column"></th>
                                            <th>Location</th>
                                            <th class="text-end">Available</th>
                                            <th class="change-quantity-column">Quantity</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var option in DisplayChangeOptions)
                                        {
                                            <tr class="@(_selectedChangePositionIds.Contains(option.Id) ? "putaway-location-selected" : null)">
                                                <td class="selection-column"><input class="form-check-input" type="checkbox"
                                                    aria-label="Select @option.LocationCode"
                                                    checked="@_selectedChangePositionIds.Contains(option.Id)"
                                                    @onchange="eventArgs => ToggleChangeLocation(option, eventArgs)" /></td>
                                                <td>
                                                    <div class="putaway-location-identity">
                                                        <span class="record-code">@option.LocationCode</span>
                                                        @if (option.IsCurrent)
                                                        {
                                                            <span class="putaway-current-badge">Current</span>
                                                        }
                                                    </div>
                                                    <div class="putaway-location-meta">
                                                        <span>Rack @RackCodeOf(option.LocationCode)</span>
                                                        <span>@option.LocationSubtypeName</span>
                                                        <span>@option.ZoneTypeName</span>
                                                    </div>
                                                </td>
                                                <td class="text-end"><strong>@option.FreeBoxes.ToString("0.###")</strong><span class="putaway-capacity"> of @option.CapacityBoxes</span></td>
                                                <td class="change-quantity-column">
                                                    <input class="form-control form-control-sm" type="number" min="1"
                                                           max="@MaximumQuantityFor(option)" step="1"
                                                           aria-label="Quantity for @option.LocationCode"
                                                           disabled="@(!_selectedChangePositionIds.Contains(option.Id))"
                                                           placeholder="Select first"
                                                           value="@(_selectedChangePositionIds.Contains(option.Id) ? QuantityFor(option) : null)"
                                                           @oninput="eventArgs => SetQuantity(option.Id, eventArgs.Value?.ToString())" />
                                                    <div class="form-text">Max @MaximumQuantityFor(option).ToString("0.###")</div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <div class="slide-over-footer putaway-change-footer">
                        <div class="putaway-selection-summary">
                            <strong>@SelectedChangeQuantity.ToString("0.###") / @_changeMaximumQuantityBoxes.ToString("0.###") boxes</strong>
                            <span>@_selectedChangePositionIds.Count location(s) selected</span>
                        </div>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseChangeLocation">Cancel</button>
                        <button type="button" class="btn btn-primary" disabled="@(!CanApplyChanges)" @onclick="ApplyAllocationsAsync">Apply changes</button>
                    </div>
                </div>
            </div>
        }

        @if (_isBulkRackChangeOpen)
        {
            <div class="slide-over-backdrop" role="presentation" @onclick="CloseBulkRackChange">
                <div class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="history-bulk-rack-title" @onclick:stopPropagation="true">
                    <div class="slide-over-header">
                        <div>
                            <div class="eyebrow">Put-away Reservations</div>
                            <h2 id="history-bulk-rack-title" class="slide-over-title">Move Selected to Rack</h2>
                            <p class="slide-over-subtitle">Move @_selectedPutawayIds.Count selected unconfirmed allocation(s) at once.</p>
                        </div>
                        <button type="button" class="slide-over-close" aria-label="Close bulk rack change" @onclick="CloseBulkRackChange">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="slide-over-body">
                        @if (!string.IsNullOrWhiteSpace(_bulkRackChangeError))
                        {
                            <div class="alert alert-danger mb-3">@_bulkRackChangeError</div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Destination rack <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="_bulkRackCode">
                                <option value="">Select rack</option>
                                @foreach (var rack in _bulkRacks.Where(r => r.IsActive))
                                {
                                    <option value="@rack.Code">Rack @rack.Code</option>
                                }
                            </select>
                            <div class="form-text">The system will use compatible available positions within this rack.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reason for override <span class="text-danger">*</span></label>
                            <input class="form-control" maxlength="250" placeholder="e.g. Move this receipt to another rack"
                                   @bind="_bulkRackReason" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="slide-over-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseBulkRackChange">Close</button>
                        <button type="button" class="btn btn-primary"
                                disabled="@(_movingSelectedPutaways || string.IsNullOrWhiteSpace(_bulkRackCode) || string.IsNullOrWhiteSpace(_bulkRackReason))"
                                @onclick="MoveSelectedPutawaysAsync">
                            <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                            @(_movingSelectedPutaways ? "Moving..." : $"Move {_selectedPutawayIds.Count} allocation(s)")
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (_isLocationUploadOpen)
        {
            <div class="slide-over-backdrop" role="presentation" @onclick="CloseLocationUpload">
                <div class="slide-over-panel" role="dialog" aria-modal="true" aria-labelledby="location-upload-title" @onclick:stopPropagation="true">
                    <div class="slide-over-header">
                        <div>
                            <div class="eyebrow">GRN Allocation Update</div>
                            <h2 id="location-upload-title" class="slide-over-title">Upload Allocation Changes</h2>
                            <p class="slide-over-subtitle">Update pending quantities and pallet positions for @_detail.ReferenceNumber.</p>
                        </div>
                        <button type="button" class="slide-over-close" aria-label="Close upload" @onclick="CloseLocationUpload">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="slide-over-body">
                        @if (!string.IsNullOrWhiteSpace(_locationUploadError))
                        {
                            <div class="alert alert-danger mb-3">@_locationUploadError</div>
                        }

                        <div class="putaway-info-bar transaction-status-bar mb-4" role="note">
                            <div class="info-bar-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
                            <div class="info-bar-content">
                                <h2>Validated before saving</h2>
                                <p>Edit only the blue Pallet Position and Qty at Position columns for pending rows. SKU, PKM, requested totals, location compatibility, and final capacity are validated together. If any row fails, nothing is changed.</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Updated GRN workbook <span class="text-danger">*</span></label>
                            <InputFile class="form-control" accept=".xlsx" OnChange="OnLocationWorkbookSelected" />
                            <div class="form-text">First download the latest workbook, edit pending Pallet Position or Qty at Position values, then upload the complete file.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Reason for allocation changes <span class="text-danger">*</span></label>
                            <input class="form-control" maxlength="250" placeholder="e.g. Physical slot unavailable during put-away"
                                   @bind="_locationUploadReason" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="slide-over-footer">
                        <button type="button" class="btn btn-outline-secondary" disabled="@_uploadingLocationChanges" @onclick="CloseLocationUpload">Close</button>
                        <button type="button" class="btn btn-primary"
                                disabled="@(_uploadingLocationChanges || _locationWorkbook is null || string.IsNullOrWhiteSpace(_locationUploadReason))"
                                @onclick="UploadLocationChangesAsync">
                            <i class="bi bi-upload" aria-hidden="true"></i>
                            @(_uploadingLocationChanges ? "Validating..." : "Validate & Apply Changes")
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int TransactionId { get; set; }

    private InwardDetailDto? _detail;
    private bool _loading = true;
    private string? _error;
    private bool _isPalletDetailsOpen;
    private bool _confirming;
    private string? _confirmationMessage;
    private bool _showRejectPanel;
    private string _rejectReason = string.Empty;
    private bool _rejecting;
    private string? _rejectError;
    private bool _reallocating;
    private string? _reallocationMessage;
    private string? _reallocationError;
    private bool _refreshingPutaway;
    private string? _refreshPutawayMessage;
    private string? _refreshPutawayError;
    private PalletPositionDto? _selectedPalletPosition;
    private string? _palletDetailsError;
    private bool _isChangeLocationOpen;
    private int _changingPutawayId;
    private string _changeCurrentLocationCode = string.Empty;
    private decimal _changeOriginalQuantityBoxes;
    private decimal _changeMaximumQuantityBoxes;
    private readonly Dictionary<int, decimal> _changeQuantities = [];
    private readonly HashSet<int> _selectedChangePositionIds = [];
    private IReadOnlyList<InwardPalletChangeOptionDto>? _changeOptions;
    private string _changeLocationSearch = string.Empty;
    private string _changeRackFilter = string.Empty;
    private string _changeReason = string.Empty;
    private string? _changeError;
    private bool _changingLocation;
    private readonly HashSet<int> _selectedPutawayIds = [];
    private bool _isBulkRackChangeOpen;
    private IReadOnlyList<RackDto> _bulkRacks = Array.Empty<RackDto>();
    private string _bulkRackCode = string.Empty;
    private string _bulkRackReason = string.Empty;
    private string? _bulkRackChangeError;
    private bool _movingSelectedPutaways;
    private bool _isLocationUploadOpen;
    private IBrowserFile? _locationWorkbook;
    private string _locationUploadReason = string.Empty;
    private string? _locationUploadError;
    private bool _uploadingLocationChanges;
    private string _sortBy = "material";
    private bool _sortDescending;

    private decimal TotalQtyBoxes => _detail?.Lines.Sum(l => l.RequestedQuantityBoxes) ?? 0;

    private decimal PutawayQtyBoxes =>
        _detail?.Lines.SelectMany(l => l.Putaways).Where(p => p.IsConfirmed).Sum(p => p.QuantityBoxes) ?? 0;

    private decimal PendingQtyBoxes => Math.Max(0, TotalQtyBoxes - PutawayQtyBoxes);

    private int LocationsUsedCount =>
        _detail?.Lines.SelectMany(l => l.Putaways).Select(p => p.LocationCode).Distinct().Count() ?? 0;

    private int OverridesCount =>
        _detail?.Lines.SelectMany(l => l.Putaways).Count(p => !string.IsNullOrWhiteSpace(p.OverrideReason)) ?? 0;

    private DateTimeOffset? CompletionDate =>
        _detail?.Lines.SelectMany(l => l.Putaways).Select(p => p.ConfirmedAt).Max();

    private string? CompletedByUserName =>
        _detail?.Lines.SelectMany(l => l.Putaways)
            .Where(p => p.ConfirmedAt.HasValue)
            .OrderByDescending(p => p.ConfirmedAt)
            .Select(p => p.ConfirmedByUserName)
            .FirstOrDefault();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _detail = await Mediator.Send(new GetInwardDetailQuery(TransactionId));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ConfirmPutawayAsync()
    {
        if (_detail is null || _detail.IsConfirmed)
        {
            return;
        }

        _error = null;
        _confirmationMessage = null;
        _confirming = true;

        try
        {
            await Mediator.Send(new ConfirmInwardPutawayCommand(_detail.ReferenceNumber));
            _detail = await Mediator.Send(new GetInwardDetailQuery(TransactionId));
            _confirmationMessage = "Stock confirmed. Dashboard and inventory views now reflect this GRN.";
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast", _confirmationMessage);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Put-away confirmation failed for {ReferenceNumber}", _detail.ReferenceNumber);
            _error = ex.Message;
        }
        finally
        {
            _confirming = false;
        }
    }
    private async Task OpenPalletDetailsAsync(string locationCode)
    {
        _selectedPalletPosition = null;
        _palletDetailsError = null;
        _isPalletDetailsOpen = true;

        try
        {
            _selectedPalletPosition = await Mediator.Send(new GetPalletPositionByCodeQuery(locationCode));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to load pallet details for {LocationCode}", locationCode);
            _palletDetailsError = ex.Message;
        }
    }

    private void ClosePalletDetails()
    {
        _isPalletDetailsOpen = false;
        _selectedPalletPosition = null;
        _palletDetailsError = null;
    }

    private async Task OpenChangeLocationAsync(int putawayId, string currentLocationCode, decimal quantityBoxes, decimal maximumQuantityBoxes)
    {
        _changingPutawayId = putawayId;
        _changeCurrentLocationCode = currentLocationCode;
        _changeOriginalQuantityBoxes = quantityBoxes;
        _changeMaximumQuantityBoxes = maximumQuantityBoxes;
        _changeQuantities.Clear();
        _selectedChangePositionIds.Clear();
        _changeOptions = null;
        _changeLocationSearch = string.Empty;
        _changeRackFilter = RackCodeOf(currentLocationCode);
        _changeReason = string.Empty;
        _changeError = null;
        _isChangeLocationOpen = true;

        try
        {
            _changeOptions = await Mediator.Send(new GetInwardPalletChangeOptionsQuery(putawayId));
            foreach (var option in _changeOptions)
            {
                _changeQuantities[option.Id] = option.IsCurrent
                    ? quantityBoxes
                    : Math.Min(quantityBoxes, MaximumQuantityFor(option));
                if (option.IsCurrent) _selectedChangePositionIds.Add(option.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to load pallet change options for putaway {PutawayId}", putawayId);
            _changeError = ex.Message;
        }
    }

    private void CloseChangeLocation()
    {
        _isChangeLocationOpen = false;
        _changeOptions = null;
        _changeQuantities.Clear();
        _selectedChangePositionIds.Clear();
        _changeRackFilter = string.Empty;
        _changeError = null;
    }

    private async Task MoveToLocationAsync(int newPositionId)
    {
        _changingLocation = true;
        _changeError = null;
        try
        {
            await Mediator.Send(new ChangeInwardPutawayLocationCommand(
                _changingPutawayId, newPositionId, _changeReason, _changeQuantities.GetValueOrDefault(newPositionId)));
            _detail = await Mediator.Send(new GetInwardDetailQuery(TransactionId));
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast", "Put-away allocation updated.");
            CloseChangeLocation();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to change put-away location for putaway {PutawayId}", _changingPutawayId);
            _changeError = ex.Message;
        }
        finally
        {
            _changingLocation = false;
        }
    }

    private bool CanApplyChange(InwardPalletChangeOptionDto option, bool requireChange = false)
    {
        var quantity = QuantityFor(option);
        if (_changingLocation || string.IsNullOrWhiteSpace(_changeReason)
            || quantity <= 0 || !decimal.IsInteger(quantity)
            || quantity > MaximumQuantityFor(option))
        {
            return false;
        }

        return !requireChange || !option.IsCurrent || quantity != _changeOriginalQuantityBoxes;
    }

    private decimal QuantityFor(InwardPalletChangeOptionDto option) =>
        _changeQuantities.GetValueOrDefault(option.Id, Math.Min(_changeOriginalQuantityBoxes, MaximumQuantityFor(option)));

    private decimal MaximumQuantityFor(InwardPalletChangeOptionDto option) =>
        Math.Min(_changeMaximumQuantityBoxes, option.FreeBoxes);

    private void SetQuantity(int positionId, string? value)
    {
        _changeQuantities[positionId] = decimal.TryParse(value, out var quantity) ? quantity : 0;
    }

    private decimal SelectedChangeQuantity => _selectedChangePositionIds.Sum(id => _changeQuantities.GetValueOrDefault(id));
    private bool CanApplyChanges => !_changingLocation && !string.IsNullOrWhiteSpace(_changeReason)
        && _selectedChangePositionIds.Count > 0 && SelectedChangeQuantity > 0
        && SelectedChangeQuantity <= _changeMaximumQuantityBoxes
        && _selectedChangePositionIds.All(id => decimal.IsInteger(_changeQuantities.GetValueOrDefault(id))
            && _changeQuantities.GetValueOrDefault(id) > 0
            && _changeQuantities.GetValueOrDefault(id) <= MaximumQuantityFor(_changeOptions!.First(o => o.Id == id)));

    private void ToggleChangeLocation(InwardPalletChangeOptionDto option, ChangeEventArgs args)
    {
        var isSelected = args.Value is true
            || (args.Value is string value && bool.TryParse(value, out var parsed) && parsed);
        if (!isSelected)
        {
            _selectedChangePositionIds.Remove(option.Id);
            return;
        }

        _selectedChangePositionIds.Add(option.Id);
        var quantityAtOtherSelectedLocations = _selectedChangePositionIds
            .Where(id => id != option.Id)
            .Sum(id => _changeQuantities.GetValueOrDefault(id));
        var remainingForLocation = Math.Max(0, _changeMaximumQuantityBoxes - quantityAtOtherSelectedLocations);
        var currentQuantity = _changeQuantities.GetValueOrDefault(option.Id);
        if (currentQuantity <= 0 || currentQuantity > remainingForLocation)
        {
            _changeQuantities[option.Id] = Math.Min(MaximumQuantityFor(option), remainingForLocation);
        }
    }

    private async Task ApplyAllocationsAsync()
    {
        _changingLocation = true;
        _changeError = null;
        try
        {
            var destinations = _selectedChangePositionIds.Select(id =>
                new InwardPutawayDestination(id, _changeQuantities[id])).ToList();
            await Mediator.Send(new ChangeInwardPutawayAllocationsCommand(_changingPutawayId, destinations, _changeReason));
            _detail = await Mediator.Send(new GetInwardDetailQuery(TransactionId));
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast", "Put-away allocations updated.");
            CloseChangeLocation();
        }
        catch (Exception ex) { _changeError = ex.Message; }
        finally { _changingLocation = false; }
    }

    private IEnumerable<PutawayDetailRow> DisplayPutawayRows
    {
        get
        {
            var rows = (_detail?.Lines ?? Array.Empty<InwardDetailLineDto>()).SelectMany(line =>
            line.Putaways.Count == 0
                ? [new PutawayDetailRow(line, null)]
                : line.Putaways.Select(putaway => new PutawayDetailRow(line, putaway)));

            return (_sortBy, _sortDescending) switch
            {
                ("material", false) => rows.OrderBy(r => r.Line.MaterialNumber).ThenBy(r => r.Line.MaterialDescription),
                ("material", true) => rows.OrderByDescending(r => r.Line.MaterialNumber).ThenByDescending(r => r.Line.MaterialDescription),
                ("pkm", false) => rows.OrderBy(r => ParseMfgMonth(r.Line.MfgMonthLabel)),
                ("pkm", true) => rows.OrderByDescending(r => ParseMfgMonth(r.Line.MfgMonthLabel)),
                ("requested", false) => rows.OrderBy(r => r.Line.RequestedQuantityBoxes),
                ("requested", true) => rows.OrderByDescending(r => r.Line.RequestedQuantityBoxes),
                ("allocated", false) => rows.OrderBy(r => r.AllocatedQuantityBoxes),
                ("allocated", true) => rows.OrderByDescending(r => r.AllocatedQuantityBoxes),
                ("status", false) => rows.OrderBy(r => r.Line.Status),
                ("status", true) => rows.OrderByDescending(r => r.Line.Status),
                ("location", false) => rows.OrderBy(r => r.Putaway?.LocationCode ?? string.Empty),
                ("location", true) => rows.OrderByDescending(r => r.Putaway?.LocationCode ?? string.Empty),
                _ => rows
            };
        }
    }

    private IEnumerable<int> SelectablePutawayIds =>
        DisplayPutawayRows
            .Where(row => row.Putaway is { IsConfirmed: false, Id: > 0 })
            .Select(row => row.Putaway!.Id);

    private bool AreAllVisiblePutawaysSelected
    {
        get
        {
            var ids = SelectablePutawayIds.ToArray();
            return ids.Length > 0 && ids.All(_selectedPutawayIds.Contains);
        }
    }

    private void TogglePutaway(int putawayId, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            _selectedPutawayIds.Add(putawayId);
        }
        else
        {
            _selectedPutawayIds.Remove(putawayId);
        }
    }

    private void ToggleAllVisiblePutaways(ChangeEventArgs args)
    {
        var ids = SelectablePutawayIds.ToArray();
        if (args.Value is true)
        {
            _selectedPutawayIds.UnionWith(ids);
        }
        else
        {
            _selectedPutawayIds.ExceptWith(ids);
        }
    }

    private async Task OpenBulkRackChangeAsync()
    {
        if (_selectedPutawayIds.Count == 0) return;
        _bulkRackChangeError = null;
        _bulkRackCode = string.Empty;
        _bulkRackReason = string.Empty;
        _isBulkRackChangeOpen = true;
        try
        {
            _bulkRacks = await Mediator.Send(new GetRacksQuery());
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to load racks for bulk put-away change");
            _bulkRackChangeError = ex.Message;
        }
    }

    private void CloseBulkRackChange()
    {
        _isBulkRackChangeOpen = false;
        _bulkRackChangeError = null;
    }

    private async Task MoveSelectedPutawaysAsync()
    {
        if (_selectedPutawayIds.Count == 0) return;
        _movingSelectedPutaways = true;
        _bulkRackChangeError = null;
        try
        {
            var count = _selectedPutawayIds.Count;
            await Mediator.Send(new ChangeInwardPutawayRackCommand(
                _selectedPutawayIds.ToArray(), _bulkRackCode, _bulkRackReason));
            _detail = await Mediator.Send(new GetInwardDetailQuery(TransactionId));
            _selectedPutawayIds.Clear();
            CloseBulkRackChange();
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast", $"{count} put-away allocation(s) moved to Rack {_bulkRackCode}.");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to move selected put-away allocations to rack {RackCode}", _bulkRackCode);
            _bulkRackChangeError = ex.Message;
        }
        finally
        {
            _movingSelectedPutaways = false;
        }
    }

    private IEnumerable<InwardPalletChangeOptionDto> DisplayChangeOptions
    {
        get
        {
            var query = (_changeOptions ?? Array.Empty<InwardPalletChangeOptionDto>()).AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_changeLocationSearch))
            {
                var term = _changeLocationSearch.Trim();
                query = query.Where(o =>
                    o.LocationCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    o.LocationSubtypeName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    o.ZoneTypeName.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_changeRackFilter))
            {
                query = query.Where(o => RackCodeOf(o.LocationCode).Equals(_changeRackFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private IEnumerable<string> ChangeRackOptions =>
        (_changeOptions ?? Array.Empty<InwardPalletChangeOptionDto>())
            .Select(o => RackCodeOf(o.LocationCode))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(code => code, StringComparer.OrdinalIgnoreCase);

    private static string RackCodeOf(string locationCode)
    {
        var lastSeparator = locationCode.LastIndexOf('-');
        var rackSeparator = lastSeparator > 0 ? locationCode.LastIndexOf('-', lastSeparator - 1) : -1;
        return rackSeparator > 0 ? locationCode[..rackSeparator] : locationCode;
    }

    private void SortBy(string column)
    {
        if (_sortBy == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortBy = column;
            _sortDescending = false;
        }
    }

    private string SortIcon(string column) =>
        _sortBy == column ? (_sortDescending ? "bi-sort-down-alt" : "bi-sort-up") : "bi-arrow-down-up";

    private string SortAria(string column) =>
        _sortBy != column ? "none" : _sortDescending ? "descending" : "ascending";

    private static DateTime ParseMfgMonth(string value) =>
        DateTime.TryParseExact(value, "MMM|yyyy", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AllowWhiteSpaces, out var month)
                ? month
                : DateTime.MaxValue;

    private static decimal CompletionRate(decimal completed, decimal requested) =>
        requested > 0 ? Math.Min(100, completed / requested * 100) : 0;

    private static string PutawayTitle(InwardPutawayDto putaway) =>
        string.IsNullOrWhiteSpace(putaway.Reason)
            ? $"{(putaway.IsConfirmed ? "Confirmed" : "Reserved")} - view pallet details for {putaway.LocationCode}"
            : $"{putaway.Reason} - view pallet details for {putaway.LocationCode}";

    /// <summary>
    /// Rejectable only before any of its put-aways are confirmed - confirming already wrote real
    /// StockBatch inventory, which rejection isn't meant to reverse. Checked directly against the
    /// putaways rather than <c>_detail.IsConfirmed</c>, since that flag is vacuously true for a
    /// GRN with zero putaways at all (a fully failed allocation) - which should still be
    /// rejectable to clear it out of the pending queue.
    /// </summary>
    private bool CanReject =>
        _detail is not null && !_detail.IsRejected &&
        !_detail.Lines.SelectMany(l => l.Putaways).Any(p => p.IsConfirmed);

    /// <summary>
    /// Offered whenever any line still has an allocation gap (Partial or Failed) and the GRN
    /// hasn't been rejected - deliberately not gated on <c>_detail.IsConfirmed</c>, since that's
    /// vacuously true for a line with zero putaways (a totally failed allocation), and unrelated
    /// to whether OTHER lines' already-confirmed putaways exist: reallocation only ever adds new
    /// reservations for a line's remaining gap, it never touches an already-confirmed one.
    /// </summary>
    private bool CanReallocate =>
        _detail is not null && !_detail.IsRejected &&
        _detail.Lines.Any(l => l.Status != AllocationStatus.Fulfilled);

    private bool CanRefreshPutaway =>
        _detail is not null && !_detail.IsRejected &&
        (_detail.Lines.Any(l => l.Putaways.Any(p => !p.IsConfirmed))
         || _detail.Lines.Any(l => l.AllocatedQuantityBoxes < l.RequestedQuantityBoxes));

    private async Task RefreshPutawayAsync()
    {
        if (_detail is null || !CanRefreshPutaway || _refreshingPutaway)
        {
            return;
        }

        _refreshingPutaway = true;
        _refreshPutawayMessage = null;
        _refreshPutawayError = null;
        try
        {
            await Mediator.Send(new RefreshInwardPutawayCommand(_detail.Id));
            _detail = await Mediator.Send(new GetInwardDetailQuery(TransactionId));
            var reserved = _detail.Lines.SelectMany(x => x.Putaways).Where(x => !x.IsConfirmed).Sum(x => x.QuantityBoxes);
            var locations = _detail.Lines.SelectMany(x => x.Putaways).Where(x => !x.IsConfirmed).Select(x => x.LocationCode).Distinct().Count();
            _refreshPutawayMessage = $"Latest preferences applied: {reserved:0.###} box(es) reserved across {locations} location(s).";
            _selectedPutawayIds.Clear();
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast", "Put-away refreshed using the latest location preferences.");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh put-away for GRN {TransactionId}", _detail.Id);
            _refreshPutawayError = ex.Message;
        }
        finally
        {
            _refreshingPutaway = false;
        }
    }

    private async Task ReallocateAsync()
    {
        if (_detail is null)
        {
            return;
        }

        _reallocating = true;
        _reallocationMessage = null;
        _reallocationError = null;
        try
        {
            var before = _detail.Lines.Sum(l => l.AllocatedQuantityBoxes);
            await Mediator.Send(new ReallocateInwardCommand(_detail.Id));
            _detail = await Mediator.Send(new GetInwardDetailQuery(TransactionId));
            var newlyPlaced = _detail.Lines.Sum(l => l.AllocatedQuantityBoxes) - before;
            var stillPending = _detail.Lines.Sum(l => l.RequestedQuantityBoxes - l.AllocatedQuantityBoxes);

            _reallocationMessage = newlyPlaced > 0
                ? $"Reallocation placed {newlyPlaced:0.###} more box(es)." + (stillPending > 0 ? $" {stillPending:0.###} box(es) still pending capacity." : string.Empty)
                : "No additional capacity was available - nothing could be reallocated right now.";
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast", _reallocationMessage);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to reallocate GRN {TransactionId}", _detail.Id);
            _reallocationError = ex.Message;
        }
        finally
        {
            _reallocating = false;
        }
    }

    private async Task DownloadExcelAsync()
    {
        if (_detail is null) return;

        var bytes = ExcelService.WriteInwardDownload(global::GodrejWMS.Application.Features.Inward.InwardDownloadMapper.FromDetail(_detail));
        await JsRuntime.InvokeVoidAsync("godrejWms.downloadFile", $"inward-{_detail.ReferenceNumber}.xlsx", Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private bool CanUploadLocationChanges =>
        _detail is not null && !_detail.IsRejected
        && _detail.Lines.SelectMany(line => line.Putaways).Any(putaway => !putaway.IsConfirmed);

    private void OpenLocationUpload()
    {
        _locationWorkbook = null;
        _locationUploadReason = string.Empty;
        _locationUploadError = null;
        _isLocationUploadOpen = true;
    }

    private void CloseLocationUpload()
    {
        if (_uploadingLocationChanges) return;
        _isLocationUploadOpen = false;
        _locationWorkbook = null;
        _locationUploadError = null;
    }

    private void OnLocationWorkbookSelected(InputFileChangeEventArgs args)
    {
        _locationWorkbook = args.File;
        _locationUploadError = null;
    }

    private async Task UploadLocationChangesAsync()
    {
        if (_detail is null || _locationWorkbook is null || string.IsNullOrWhiteSpace(_locationUploadReason)) return;

        _uploadingLocationChanges = true;
        _locationUploadError = null;
        try
        {
            await using var source = _locationWorkbook.OpenReadStream(10 * 1024 * 1024);
            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);
            memory.Position = 0;

            var result = await Mediator.Send(new ImportInwardPutawayLocationsCommand(
                _detail.Id, memory, _locationUploadReason));
            _detail = await Mediator.Send(new GetInwardDetailQuery(TransactionId));
            _isLocationUploadOpen = false;
            _locationWorkbook = null;
            var updatedParts = new List<string>();
            if (result.UpdatedLocations > 0) updatedParts.Add($"{result.UpdatedLocations} location(s)");
            if (result.UpdatedQuantities > 0) updatedParts.Add($"{result.UpdatedQuantities} quantity value(s)");
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast",
                updatedParts.Count == 0
                    ? "Workbook validated. No allocations were changed."
                    : $"Updated {string.Join(" and ", updatedParts)} from Excel.");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to import put-away locations for GRN {TransactionId}", _detail.Id);
            _locationUploadError = ex.Message;
        }
        finally
        {
            _uploadingLocationChanges = false;
        }
    }

    private void ToggleRejectPanel()
    {
        _showRejectPanel = !_showRejectPanel;
        _rejectReason = string.Empty;
        _rejectError = null;
    }

    private async Task RejectGrnAsync()
    {
        if (_detail is null || string.IsNullOrWhiteSpace(_rejectReason))
        {
            return;
        }

        _rejecting = true;
        _rejectError = null;
        try
        {
            await Mediator.Send(new RejectInwardCommand(_detail.Id, _rejectReason));
            _detail = await Mediator.Send(new GetInwardDetailQuery(TransactionId));
            _showRejectPanel = false;
            await JsRuntime.InvokeVoidAsync("godrejWms.showToast", "GRN rejected. Reserved locations have been released.");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to reject GRN {TransactionId}", _detail.Id);
            _rejectError = ex.Message;
        }
        finally
        {
            _rejecting = false;
        }
    }

    private bool HasAnyAllocation() =>
        _detail?.Lines.Any(l => l.AllocatedQuantityBoxes > 0) == true;

    private bool HasAnyReservation() =>
        _detail?.Lines.SelectMany(l => l.Putaways).Any() == true;

    private static string StepClass(bool isComplete) => isComplete ? "complete" : "pending";


    private static string ZoneClass(string code) => code switch
    {
        "Fast" => "fast",
        "DispatchNear" => "info",
        "Seasonal" => "warning",
        _ => "slate"
    };

    private static string SubtypeClass(string code) => code switch
    {
        "Good" => "success",
        "Damage" => "danger",
        "Expire" => "warning",
        "Hold" => "violet",
        _ => "slate"
    };

    private static decimal OccupancyPercent(PalletPositionDto position) =>
        position.CapacityBoxes is not { } capacity || capacity <= 0 ? 0 : Math.Clamp(position.OccupiedBoxes / capacity * 100, 0, 100);
    private static string AllocationClass(AllocationStatus status) => status switch
    {
        AllocationStatus.Fulfilled => "success",
        AllocationStatus.Partial => "warning",
        _ => "danger"
    };

    private sealed record PutawayDetailRow(InwardDetailLineDto Line, InwardPutawayDto? Putaway)
    {
        public decimal AllocatedQuantityBoxes => Putaway?.QuantityBoxes ?? Line.AllocatedQuantityBoxes;
    }
}





