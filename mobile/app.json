{
  "expo": {
    "name": "Godrej WMS",
    "slug": "godrejwms-pickers",
    "scheme": "godrejwms-pickers",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.logivue.gcpl.wms.pickers"
    },
    "android": {
      "package": "in.logivue.gcpl.wms.pickers",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Godrej WMS to use the camera to scan location barcodes/QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Godrej WMS to use your location to verify you're at your assigned warehouse when signing in."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "acf501ab-90e8-40e6-91b5-2c765cd1329e"
      }
    },
    "owner": "shakyens"
  }
}
